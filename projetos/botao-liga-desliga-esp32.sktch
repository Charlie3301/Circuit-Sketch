    "Cor": "#1F6FD1"
   },
   {
    "DePeca": "botao",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}