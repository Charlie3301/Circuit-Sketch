{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "ESP32 numa LiPo 1S pelo AMS1117 (o limite da folga)",
  "",
  "Um erro comum: o AMS1117-3.3 numa LiPo de uma celula. Ele precisa de",
  "~1,1 V a mais na entrada do que na saida: com a LiPo cheia (4,2 V) ele",
  "so consegue ~3,1 V (a ESP32 ainda liga, no limite); com a LiPo em 3,7 V",
  "sai ~2,6 V, e a ESP32 apaga.",
  "",
  "Mude a tensao da bateria na barra dela e veja. Para uma celula de litio",
  "use um regulador de folga pequena (HT7333, ME6211) ou um buck-boost."
 ],
 "codigo": [
  "// A ESP32 numa LiPo de uma celula pelo AMS1117-3.3.",
  "// O AMS1117 precisa de ~1,1 V de folga: com a LiPo cheia (4,2 V) ele",
  "// da ~3,1 V; com ela em 3,7 V, so 2,6 V -- e a ESP32 nao liga.",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(2, OUTPUT);",
  "  Serial.println(\"ESP32 ligada pelo AMS1117\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(2, !digitalRead(2));",
  "  delay(400);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 40,
    "Y": 40
   },
   {
    "Id": "reg",
    "Tipo": "ams1117",
    "X": 300,
    "Y": 320
   },
   {
    "Id": "bat",
    "Tipo": "bateria",
    "X": 460,
    "Y": 320,
    "Volts": 4.2,
    "MiliAmperes": 10000,
    "MiliAmperesHora": 1000,
    "Nome": "LiPo 1S 1000 mAh (carregada, 4,2 V)"
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 260,
    "Y": 0,
    "Cor": "verde"
   },
   {
    "Id": "r_led",
    "Tipo": "resistor",
    "X": 190,
    "Y": 60,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "D2",
    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#00A651"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "bat",
    "DePino": "+",
    "ParaPeca": "reg",
    "ParaPino": "VIN",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "bat",
    "DePino": "-",
    "ParaPeca": "reg",
    "ParaPino": "GND",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "reg",
    "DePino": "VOUT",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "reg",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}