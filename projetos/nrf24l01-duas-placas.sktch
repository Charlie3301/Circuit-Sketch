{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Dois Unos conversando por nRF24L01",
  "",
  "Dois modulos de radio nRF24L01 (SPI, biblioteca RF24): um Uno manda um",
  "contador a cada meio segundo, o outro recebe e mostra no monitor.",
  "O nRF24 e de 3,3 V: o VCC vai no 3.3V do Uno."
 ],
 "codigo": [
  "// nRF24L01, o emissor: um contador a cada meio segundo.",
  "#include <SPI.h>",
  "#include <RF24.h>",
  "",
  "RF24 radio(9, 10);",
  "const byte endereco[6] = \"00001\";",
  "int contador = 0;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  radio.begin();",
  "  radio.openWritingPipe(endereco);",
  "  radio.stopListening();",
  "}",
  "",
  "void loop() {",
  "  contador++;",
  "  radio.write(&contador, sizeof(contador));",
  "  Serial.print(\"enviei \");",
  "  Serial.println(contador);",
  "  delay(500);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 220,
    "Codigo": [
     "// nRF24L01, o emissor: um contador a cada meio segundo.",
     "#include <SPI.h>",
     "#include <RF24.h>",
     "",
     "RF24 radio(9, 10);",
     "const byte endereco[6] = \"00001\";",
     "int contador = 0;",
     "",
     "void setup() {",
     "  Serial.begin(9600);",
     "  radio.begin();",
     "  radio.openWritingPipe(endereco);",
     "  radio.stopListening();",
     "}",
     "",
     "void loop() {",
     "  contador++;",
     "  radio.write(&contador, sizeof(contador));",
     "  Serial.print(\"enviei \");",
     "  Serial.println(contador);",
     "  delay(500);",
     "}"
    ]
   },
   {
    "Id": "radio1",
    "Tipo": "nrf24l01",
    "X": 380,
    "Y": 40
   },
   {
    "Id": "placa2",
    "Tipo": "arduino-uno",
    "X": 600,
    "Y": 220,
    "Codigo": [
     "// nRF24L01, o receptor.",
     "#include <SPI.h>",
     "#include <RF24.h>",
     "",
     "RF24 radio(9, 10);",
     "const byte endereco[6] = \"00001\";",
     "",
     "void setup() {",
     "  Serial.begin(9600);",
     "  radio.begin();",
     "  radio.openReadingPipe(0, endereco);",
     "  radio.startListening();",
     "}",
     "",
     "void loop() {",
     "  if (radio.available()) {",
     "    int valor = 0;",
     "    radio.read(&valor, sizeof(valor));",
     "    Serial.print(\"recebido \");",
     "    Serial.println(valor);",
     "  }",
     "}"
    ]
   },
   {
    "Id": "radio2",
    "Tipo": "nrf24l01",
    "X": 940,
    "Y": 40
   }
