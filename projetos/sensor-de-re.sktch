    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "placa",
    "DePino": "8",
    "ParaPeca": "buzzer",
    "ParaPino": "1",
    "Cor": "#F07F1A"
   },
   {
    "DePeca": "buzzer",
    "DePino": "2",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}