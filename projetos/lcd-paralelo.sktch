{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "LCD 16x2 sem I2C (LiquidCrystal, Uno)",
  "",
  "O LCD 16x2 ligado direto (RS, E e D4 a D7), como no exemplo HelloWorld",
  "da Arduino IDE: escreve e conta os segundos."
 ],
 "codigo": [
  "// O LCD 16x2 sem modulo I2C: 6 fios de dados (o exemplo HelloWorld).",
  "#include <LiquidCrystal.h>",
  "",
  "LiquidCrystal lcd(12, 11, 5, 4, 3, 2);",
  "",
  "void setup() {",
  "  lcd.begin(16, 2);",
  "  lcd.print(\"Ola, mundo!\");",
  "}",
  "",
  "void loop() {",
  "  lcd.setCursor(0, 1);",
  "  lcd.print(millis() / 1000);",
  "  lcd.print(\" s\");",
  "  delay(200);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 260
   },
   {
    "Id": "lcd",
    "Tipo": "lcd1602",
    "X": 380,
    "Y": 40
   }
  ],
  "Fios": [
