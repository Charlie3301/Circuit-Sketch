{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Termometro com DHT22 e LCD 16x2 I2C (Uno)",
  "",
  "O DHT22 mede temperatura e umidade; o LCD 16x2 com modulo I2C mostra as",
  "duas a cada 2 segundos. Mude a temperatura na barra do sensor."
 ],
 "codigo": [
  "// Termometro: o DHT22 no pino 2 e o LCD 16x2 I2C (endereco 0x27).",
  "#include <DHT.h>",
  "#include <Wire.h>",
  "#include <LiquidCrystal_I2C.h>",
  "",
  "DHT dht(2, DHT22);",
  "LiquidCrystal_I2C lcd(0x27, 16, 2);",
  "",
  "void setup() {",
  "  dht.begin();",
  "  lcd.init();",
  "  lcd.backlight();",
  "  lcd.print(\"Termometro\");",
  "}",
  "",
  "void loop() {",
  "  delay(2000);",
  "  float t = dht.readTemperature();",
  "  float u = dht.readHumidity();",
  "  lcd.clear();",
  "  lcd.setCursor(0, 0);",
  "  lcd.print(\"Temp: \");",
  "  lcd.print(t, 1);",
  "  lcd.print(\" C\");",
  "  lcd.setCursor(0, 1);",
  "  lcd.print(\"Umid: \");",
  "  lcd.print(u, 0);",
  "  lcd.print(\" %\");",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 220
   },
   {
