    "X": 560,
    "Y": 330,
    "Volts": 11.1,
    "MiliAmperes": 20000,
    "MiliAmperesHora": 2200,
    "Nome": "LiPo 3S 2200 mAh (11,1 V)"
   },
   {
    "Id": "r1",
    "Tipo": "resistor",
    "X": 380,
    "Y": 470,
    "Ohms": 10000
   },
   {
