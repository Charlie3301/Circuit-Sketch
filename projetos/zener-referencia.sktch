    "Id": "bat",
    "Tipo": "bateria",
    "X": 400,
    "Y": 420,
    "Volts": 9,
    "MiliAmperes": 20000,
    "MiliAmperesHora": 1000,
    "Nome": "Bateria 9 V"
   },
   {
    "Id": "r_z",
    "Tipo": "resistor",
    "X": 400,
    "Y": 140,
