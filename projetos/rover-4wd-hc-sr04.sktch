{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Rover 4WD com HC-SR04 (o seu Rover_ponte_H)",
  "",
  "O carrinho classico dos kits: o rover 4WD com o sensor ultrassonico",
  "HC-SR04 num servo SG90, que olha para os lados quando aparece um",
  "obstaculo. O codigo e o seu Rover_ponte_H.ino, sem mudar nada.",
  "",
  "Na barra do sensor, mude a distancia: acima de 10 cm o rover anda; com",
  "o obstaculo perto ele para, olha para a esquerda e para a direita e",
  "vira para o lado mais livre (ou da re e meia-volta).",
  "",
  "Repare: o ENA esta no pino 2, que nao tem PWM no Uno -- o analogWrite",
  "nele so liga ou desliga, e o lado esquerdo anda sempre no maximo (o",
  "comentario do seu codigo ja avisa)."
 ],
 "codigo": [
  "#include <Servo.h>",
  "",
  "// ===============================",
  "// PONTE H (L298N)",
  "// ===============================",
  "// Lado esquerdo (motores da esquerda em paralelo) = OUT1 / OUT2",
  "// Lado direito  (motores da direita em paralelo)  = OUT3 / OUT4",
  "//",
  "// Tire os jumpers de fábrica de ENA e ENB no módulo.",
  "//",
  "// ATENÇÃO: no Arduino Uno/Nano o pino 2 NÃO tem PWM.",
  "// Nele o analogWrite() só liga (valor >= 128) ou desliga,",
  "// então o lado esquerdo roda sempre na velocidade máxima.",
  "// O pino 3 (ENB) tem PWM e controla a velocidade normalmente.",
  "",
  "const int ENA = 2;    // lado esquerdo (sem PWM no Uno)",
  "const int IN1 = 4;",
  "const int IN2 = 5;",
  "",
  "const int IN3 = 6;",
  "const int IN4 = 7;",
  "const int ENB = 3;    // PWM - velocidade lado direito",
  "",
  "// Velocidade dos motores (0 a 255)",
  "// Motores amarelos comuns costumam travar abaixo de ~120.",
  "const int VELOCIDADE = 255;",
  "const int VELOCIDADE_CURVA = 255;",
  "",
  "// ===============================",
  "// SENSOR ULTRASSÔNICO HC-SR04",
  "// ===============================",
  "",
  "const int TRIG = 8;",
  "const int ECHO = 9;",
  "",
  "// ===============================",
  "// SERVO",
  "// ===============================",
  "",
  "const int SERVO_PIN = 10;",
  "",
  "Servo servoSensor;",
  "",
  "// Posições do sensor",
  "const int CENTRO = 90;",
  "const int ESQUERDA = 150;",
  "const int DIREITA = 30;",
  "",
  "// Distância mínima (cm)",
  "const int DISTANCIA_MINIMA = 10;",
  "",
  "",
  "// =====================================================",
  "// SETUP",
  "// =====================================================",
  "",
  "void setup() {",
  "",
  "  pinMode(ENA, OUTPUT);",
  "  pinMode(IN1, OUTPUT);",
  "  pinMode(IN2, OUTPUT);",
  "",
  "  pinMode(IN3, OUTPUT);",
  "  pinMode(IN4, OUTPUT);",
  "  pinMode(ENB, OUTPUT);",
  "",
  "  pinMode(TRIG, OUTPUT);",
  "  pinMode(ECHO, INPUT);",
  "",
  "  // Garante que os motores comecem parados",
  "  parar();",
  "",
  "  // Inicializa o servo",
  "  servoSensor.attach(SERVO_PIN);",
  "  servoSensor.write(CENTRO);",
  "",
  "  delay(1000);",
  "",
  "  Serial.begin(9600);",
  "}",
  "",
  "",
  "// =====================================================",
  "// LOOP PRINCIPAL",
  "// =====================================================",
  "",
  "void loop() {",
  "",
  "  // Sensor fica olhando para frente",
  "  servoSensor.write(CENTRO);",
  "  delay(100);",
  "",
  "  long distancia = medirDistancia();",
  "",
  "  Serial.print(\"Frente: \");",
  "  Serial.print(distancia);",
  "  Serial.println(\" cm\");",
  "",
  "  if (distancia > DISTANCIA_MINIMA) {",
  "",
  "    // Caminho livre",
  "    frente();",
  "",
  "  } else {",
  "",
  "    // Obstáculo a 10 cm ou menos",
  "    parar();",
  "    delay(300);",
  "",
  "    procurarCaminho();",
  "  }",
  "}",
  "",
  "",
  "// =====================================================",
  "// MEDIR DISTÂNCIA",
  "// =====================================================",
  "",
  "long medirDistancia() {",
  "",
  "  digitalWrite(TRIG, LOW);",
  "  delayMicroseconds(2);",
  "",
  "  digitalWrite(TRIG, HIGH);",
  "  delayMicroseconds(10);",
  "",
  "  digitalWrite(TRIG, LOW);",
  "",
  "  long tempo = pulseIn(ECHO, HIGH, 30000);",
  "",
  "  // Se não recebeu retorno",
  "  if (tempo == 0) {",
  "    return 400;",
  "  }",
  "",
  "  long distancia = tempo * 0.0343 / 2;",
  "",
  "  return distancia;",
  "}",
  "",
  "",
  "// =====================================================",
  "// PROCURAR CAMINHO",
  "// =====================================================",
  "",
  "void procurarCaminho() {",
  "",
  "  // Olha para a esquerda",
  "  servoSensor.write(ESQUERDA);",
  "  delay(600);",
  "",
  "  long distanciaEsquerda = medirDistancia();",
  "",
  "  Serial.print(\"Esquerda: \");",
  "  Serial.print(distanciaEsquerda);",
  "  Serial.println(\" cm\");",
  "",
  "  // Olha para a direita",
  "  servoSensor.write(DIREITA);",
  "  delay(600);",
  "",
  "  long distanciaDireita = medirDistancia();",
  "",
  "  Serial.print(\"Direita: \");",
  "  Serial.print(distanciaDireita);",
  "  Serial.println(\" cm\");",
  "",
  "  // Volta para o centro",
  "  servoSensor.write(CENTRO);",
  "  delay(300);",
  "",
  "  // Escolhe o melhor lado",
  "  if (distanciaEsquerda > distanciaDireita &&",
  "      distanciaEsquerda > DISTANCIA_MINIMA) {",
  "",
  "    Serial.println(\"Virando para ESQUERDA\");",
  "",
  "    virarEsquerda();",
  "    delay(600);",
  "    parar();",
  "    delay(200);",
  "  }",
  "",
  "  else if (distanciaDireita > distanciaEsquerda &&",
  "           distanciaDireita > DISTANCIA_MINIMA) {",
  "",
  "    Serial.println(\"Virando para DIREITA\");",
  "",
  "    virarDireita();",
  "    delay(600);",
  "    parar();",
  "    delay(200);",
  "  }",
  "",
  "  else {",
  "",
  "    // Os dois lados estão bloqueados",
  "    Serial.println(\"Caminho bloqueado!\");",
  "    Serial.println(\"Fazendo meia-volta.\");",
  "",
  "    tras();",
  "    delay(400);",
  "",
  "    virarDireita();",
  "    delay(1000);",
  "",
  "    parar();",
  "    delay(200);",
  "  }",
  "}",
  "",
  "",
  "// =====================================================",
  "// CONTROLE DOS LADOS",
  "// =====================================================",
  "// sentido:  1 = frente | -1 = trás | 0 = parado",
  "//",
  "// Se um lado girar ao contrário, troque os dois fios",
  "// do motor desse lado na ponte H (OUT1/OUT2 ou OUT3/OUT4).",
  "",
  "void ladoEsquerdo(int sentido, int velocidade) {",
  "",
  "  if (sentido == 1) {",
  "    digitalWrite(IN1, HIGH);",
  "    digitalWrite(IN2, LOW);",
  "  }",
  "  else if (sentido == -1) {",
  "    digitalWrite(IN1, LOW);",
  "    digitalWrite(IN2, HIGH);",
  "  }",
  "  else {",
  "    digitalWrite(IN1, LOW);",
  "    digitalWrite(IN2, LOW);",
  "    velocidade = 0;",
  "  }",
  "",
  "  analogWrite(ENA, velocidade);",
  "}",
  "",
  "void ladoDireito(int sentido, int velocidade) {",
  "",
  "  if (sentido == 1) {",
  "    digitalWrite(IN3, HIGH);",
  "    digitalWrite(IN4, LOW);",
  "  }",
  "  else if (sentido == -1) {",
  "    digitalWrite(IN3, LOW);",
  "    digitalWrite(IN4, HIGH);",
  "  }",
  "  else {",
  "    digitalWrite(IN3, LOW);",
  "    digitalWrite(IN4, LOW);",
  "    velocidade = 0;",
  "  }",
  "",
  "  analogWrite(ENB, velocidade);",
  "}",
  "",
  "",
  "// =====================================================",
  "// MOVIMENTOS",
  "// =====================================================",
  "",
  "void frente() {",
  "  ladoEsquerdo(1, VELOCIDADE);",
  "  ladoDireito(1, VELOCIDADE);",
  "}",
  "",
  "void tras() {",
  "  ladoEsquerdo(-1, VELOCIDADE);",
  "  ladoDireito(-1, VELOCIDADE);",
  "}",
  "",
  "// Gira no próprio eixo",
  "void virarEsquerda() {",
  "  ladoEsquerdo(-1, VELOCIDADE_CURVA);",
  "  ladoDireito(1, VELOCIDADE_CURVA);",
  "}",
  "",
  "void virarDireita() {",
  "  ladoEsquerdo(1, VELOCIDADE_CURVA);",
  "  ladoDireito(-1, VELOCIDADE_CURVA);",
  "}",
  "",
  "void parar() {",
  "  ladoEsquerdo(0, 0);",
  "  ladoDireito(0, 0);",
  "}",
  ""
 ],
