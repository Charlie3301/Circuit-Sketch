{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Dimmer com potenciometro (Uno, PWM)",
  "",
  "O analogRead do potenciometro (0 a 1023) vira o PWM do LED (0 a 255).",
  "Gire o potenciometro na barra dele."
 ],
 "codigo": [
  "// O potenciometro regula o brilho do LED (PWM no pino 9).",
  "void setup() {",
  "  pinMode(9, OUTPUT);",
  "}",
  "",
  "void loop() {",
  "  int leitura = analogRead(A0);          // 0 a 1023",
  "  analogWrite(9, leitura / 4);           // 0 a 255",
  "  delay(10);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 200
   },
   {
    "Id": "pot",
    "Tipo": "potentiometer",
    "X": 380,
    "Y": 330,
    "Giro": 0.1
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 380,
    "Y": 40,
    "Cor": "amarelo"
   },
   {
    "Id": "r_led",
    "Tipo": "resistor",
    "X": 310,
    "Y": 100,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "9",
    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#00A651"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "pot",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "5V",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "pot",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.2",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "pot",
    "DePino": "SIG",
    "ParaPeca": "placa",
    "ParaPino": "A0",
    "Cor": "#E8B400"
   }
  ]
 }
}