{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Balanca com HX711 e LCD I2C (Uno)",
  "",
  "A celula de carga pelo amplificador HX711 (DT no 3, SCK no 2) e o peso",
  "no LCD 16x2 I2C. Mude o peso na barra da celula."
 ],
 "codigo": [
  "// Balanca: a celula de carga pelo HX711, o peso no LCD.",
  "#include <HX711.h>",
  "#include <Wire.h>",
  "#include <LiquidCrystal_I2C.h>",
  "",
  "HX711 balanca;",
  "LiquidCrystal_I2C lcd(0x27, 16, 2);",
  "",
  "void setup() {",
  "  balanca.begin(3, 2);",
  "  balanca.set_scale(420.0);",
  "  lcd.init();",
  "  lcd.backlight();",
  "}",
  "",
  "void loop() {",
  "  float gramas = balanca.get_units(5);",
  "  lcd.setCursor(0, 0);",
  "  lcd.print(\"Peso: \");",
  "  lcd.print(gramas, 0);",
  "  lcd.print(\" g     \");",
  "  delay(300);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 260
   },
   {
    "Id": "celula",
    "Tipo": "hx711",
    "X": 380,
    "Y": 40,
    "Giro": 0.1
   },
   {
    "Id": "lcd",
    "Tipo": "lcd1602-i2c",
    "X": 520,
    "Y": 260
   }
  ],
  "Fios": [
   {
    "DePeca": "celula",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "5V",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "celula",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.2",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "celula",
    "DePino": "DT",
    "ParaPeca": "placa",
    "ParaPino": "3",
    "Cor": "#1F6FD1"
   },
   {
    "DePeca": "celula",
    "DePino": "SCK",
    "ParaPeca": "placa",
    "ParaPino": "2",
    "Cor": "#00A651"
   },
   {
    "DePeca": "lcd",
