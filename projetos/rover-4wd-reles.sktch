{
 "formato": "sktch",
 "versao": 1,
 "gerado": "projetos de teste (Alpha 24)",
 "descricao": [
  "Rover 4WD com reles (o seu Uno_DesvioObstaculos)",
  "",
  "O rover 4WD do seu Uno_DesvioObstaculos.ino: em vez da ponte H, quatro",
  "reles -- dois por lado (A = frente, B = re) -- como o comentario do",
  "codigo explica. O codigo e o seu, sem mudar nada.",
  "",
  "O codigo foi escrito para MODULOS de rele (com transistor e LED,",
  "ativos em LOW). O simulador ainda nao tem o modulo: aqui cada rele e o",
  "KS2E solto, com a bobina entre o 5V e o pino (o pino em LOW liga o",
  "rele) -- e a bobina puxa ~70 mA do pino, o dobro do que o Uno aguenta."
 ],
 "codigo": [
  "#include <Servo.h>",
  "",
  "// =====================================================",
  "// LIGACAO DOS RELES (2 reles por lado)",
  "// =====================================================",
  "// Lado ESQUERDO: motor dianteiro + traseiro em PARALELO",
  "// Lado DIREITO : motor dianteiro + traseiro em PARALELO",
  "//",
  "// Para cada lado, use 2 reles (A e B):",
  "//   COM do rele A -> fio 1 dos dois motores do lado",
  "//   COM do rele B -> fio 2 dos dois motores do lado",
  "//   NO  dos dois reles -> bateria (+)",
  "//   NC  dos dois reles -> bateria (-)",
  "//",
  "// Rele A ligado = frente | Rele B ligado = re | nenhum = parado",
  "// (nunca da curto, qualquer combinacao e segura)",
  "",
  "const int REL_ESQ_A = 4;   // Rele 1",
  "const int REL_ESQ_B = 5;   // Rele 2",
  "const int REL_DIR_A = 6;   // Rele 3",
  "const int REL_DIR_B = 7;   // Rele 4",
  "",
  "// Se um lado andar ao contrario, troque para true",
  "const bool INVERTER_ESQUERDO = false;",
  "const bool INVERTER_DIREITO  = false;",
  "",
  "// Modulos de rele comuns sao ativos em LOW",
  "const int RELE_LIGADO = LOW;",
  "const int RELE_DESLIGADO = HIGH;",
  "",
  "// =====================================================",
  "// SENSOR ULTRASSONICO HC-SR04 E SERVO",
  "// =====================================================",
  "",
  "const int TRIG = 8;",
  "const int ECHO = 9;",
  "const int SERVO_PIN = 10;",
  "",
  "Servo servoSensor;",
  "",
  "// Posicoes do sensor (mais abertas que antes: 150/30)",
  "const int CENTRO = 90;",
  "const int ESQUERDA = 180;",
  "const int DIREITA = 0;",
  "// Se o servo vibrar/zumbir no fim do curso, use 175 e 5",
  "",
  "// Distancia minima (cm)",
  "const int DISTANCIA_MINIMA = 10;",
  "",
  "// =====================================================",
  "// TEMPOS (ms) - ajuste ao seu robo",
  "// =====================================================",
  "",
  "const int TEMPO_SERVO      = 700;    // centro -> lado",
  "const int TEMPO_VARREDURA  = 1000;   // esquerda -> direita",
  "const int TEMPO_VIRAR      = 450;    // giro de ~90 graus parado",
  "const int TEMPO_RE         = 500;    // re antes da meia-volta",
  "const int TEMPO_MEIA_VOLTA = 900;    // giro de ~180 graus parado",
  "const int PAUSA            = 200;    // pausa entre movimentos",
  "",
  "",
  "// =====================================================",
  "// SETUP",
  "// =====================================================",
  "",
  "void setup() {",
  "",
  "  // Reles desligados ANTES de virar saida (evita pulso ao ligar)",
  "  int pinos[4] = {REL_ESQ_A, REL_ESQ_B, REL_DIR_A, REL_DIR_B};",
  "  for (int i = 0; i < 4; i++) {",
  "    digitalWrite(pinos[i], RELE_DESLIGADO);",
  "    pinMode(pinos[i], OUTPUT);",
  "  }",
  "",
  "  pinMode(TRIG, OUTPUT);",
  "  pinMode(ECHO, INPUT);",
  "",
  "  Serial.begin(9600);",
  "",
  "  // Faixa de pulso maior = servo gira o curso completo",
  "  servoSensor.attach(SERVO_PIN, 500, 2400);",
  "  servoSensor.write(CENTRO);",
  "",
  "  delay(1000);",
  "",
  "  Serial.println(\"Pronto. Envie 't' para testar os motores (robo no ar!).\");",
  "}",
  "",
  "",
  "// =====================================================",
  "// LOOP PRINCIPAL",
  "// =====================================================",
  "",
  "void loop() {",
  "",
  "  // Teste dos motores pelo Monitor Serial",
  "  if (Serial.available()) {",
  "    char c = Serial.read();",
  "    if (c == 't' || c == 'T') {",
  "      parar();",
  "      testarMotores();",
  "    }",
  "  }",
  "",
  "  // Sensor fica olhando para frente",
  "  servoSensor.write(CENTRO);",
  "  delay(100);",
  "",
  "  long distancia = medirDistancia();",
  "",
  "  Serial.print(\"Frente: \");",
  "  Serial.print(distancia);",
  "  Serial.println(\" cm\");",
  "",
  "  if (distancia > DISTANCIA_MINIMA) {",
  "",
  "    frente();",
  "",
  "  } else {",
  "",
  "    parar();",
  "    delay(300);",
  "    procurarCaminho();",
  "  }",
  "}",
  "",
  "",
  "// =====================================================",
  "// MEDIR DISTANCIA",
  "// =====================================================",
  "",
  "long medirDistancia() {",
  "",
  "  digitalWrite(TRIG, LOW);",
  "  delayMicroseconds(2);",
  "",
  "  digitalWrite(TRIG, HIGH);",
  "  delayMicroseconds(10);",
  "",
  "  digitalWrite(TRIG, LOW);",
  "",
  "  long tempo = pulseIn(ECHO, HIGH, 30000);",
  "",
  "  // Se nao recebeu retorno",
  "  if (tempo == 0) {",
  "    return 400;",
  "  }",
  "",
  "  return tempo * 0.0343 / 2;",
  "}",
  "",
  "",
  "// =====================================================",
  "// PROCURAR CAMINHO",
  "// =====================================================",
  "",
  "void procurarCaminho() {",
  "",
  "  // Olha para a esquerda",
  "  servoSensor.write(ESQUERDA);",
  "  delay(TEMPO_SERVO);",
  "  long distanciaEsquerda = medirDistancia();",
  "",
  "  Serial.print(\"Esquerda: \");",
  "  Serial.print(distanciaEsquerda);",
  "  Serial.println(\" cm\");",
  "",
  "  // Olha para a direita",
  "  servoSensor.write(DIREITA);",
  "  delay(TEMPO_VARREDURA);",
  "  long distanciaDireita = medirDistancia();",
  "",
  "  Serial.print(\"Direita: \");",
  "  Serial.print(distanciaDireita);",
  "  Serial.println(\" cm\");",
  "",
  "  // Volta para o centro",
  "  servoSensor.write(CENTRO);",
  "  delay(300);",
  "",
  "  bool esquerdaLivre = distanciaEsquerda > DISTANCIA_MINIMA;",
  "  bool direitaLivre  = distanciaDireita  > DISTANCIA_MINIMA;",
  "",
  "  if (!esquerdaLivre && !direitaLivre) {",
  "",
  "    // Os dois lados bloqueados: da re e faz meia-volta",
  "    Serial.println(\"Caminho bloqueado! Re e meia-volta.\");",
  "",
  "    tras();",
  "    delay(TEMPO_RE);",
  "    parar();",
  "    delay(PAUSA);",
  "",
  "    // Gira para o lado com mais espaco",
  "    if (distanciaEsquerda >= distanciaDireita) {",
  "      girarEsquerda();",
  "    } else {",
  "      girarDireita();",
  "    }",
  "    delay(TEMPO_MEIA_VOLTA);",
  "    parar();",
  "    delay(PAUSA);",
  "  }",
  "",
  "  else if (distanciaEsquerda >= distanciaDireita) {",
  "",
  "    Serial.println(\"Virando para ESQUERDA\");",
  "",
  "    girarEsquerda();",
  "    delay(TEMPO_VIRAR);",
  "    parar();",
  "    delay(PAUSA);",
  "  }",
  "",
  "  else {",
  "",
  "    Serial.println(\"Virando para DIREITA\");",
  "",
  "    girarDireita();",
  "    delay(TEMPO_VIRAR);",
  "    parar();",
  "    delay(PAUSA);",
  "  }",
  "}",
  "",
  "",
  "// =====================================================",
  "// MOTORES  (1 = frente, -1 = re, 0 = parado)",
  "// =====================================================",
  "",
  "void rele(int pino, bool ligado) {",
  "  digitalWrite(pino, ligado ? RELE_LIGADO : RELE_DESLIGADO);",
  "}",
  "",
  "void ladoEsquerdo(int v) {",
  "  if (INVERTER_ESQUERDO) v = -v;",
  "  rele(REL_ESQ_A, v > 0);",
  "  rele(REL_ESQ_B, v < 0);",
  "}",
  "",
  "void ladoDireito(int v) {",
  "  if (INVERTER_DIREITO) v = -v;",
  "  rele(REL_DIR_A, v > 0);",
  "  rele(REL_DIR_B, v < 0);",
  "}",
  "",
  "void parar()   { ladoEsquerdo(0);  ladoDireito(0); }",
  "void frente()  { ladoEsquerdo(1);  ladoDireito(1); }",
  "void tras()    { ladoEsquerdo(-1); ladoDireito(-1); }",
  "",
  "// Giros no proprio eixo (um lado pra frente, o outro pra tras)",
  "void girarEsquerda() { ladoEsquerdo(-1); ladoDireito(1); }",
  "void girarDireita()  { ladoEsquerdo(1);  ladoDireito(-1); }",
  "",
  "",
  "// =====================================================",
  "// TESTE DOS MOTORES (envie 't' no Monitor Serial)",
  "// =====================================================",
  "// Cada passo dura 1,5 s. Os DOIS motores do lado devem",
  "// girar no mesmo sentido, e \"frente\" deve ser pra frente.",
  "",
  "void testarMotores() {",
  "",
  "  Serial.println(\"TESTE: lado ESQUERDO para FRENTE\");",
  "  ladoEsquerdo(1);  delay(1500); parar(); delay(700);",
  "",
  "  Serial.println(\"TESTE: lado ESQUERDO para TRAS\");",
  "  ladoEsquerdo(-1); delay(1500); parar(); delay(700);",
  "",
  "  Serial.println(\"TESTE: lado DIREITO para FRENTE\");",
  "  ladoDireito(1);   delay(1500); parar(); delay(700);",
  "",
  "  Serial.println(\"TESTE: lado DIREITO para TRAS\");",
  "  ladoDireito(-1);  delay(1500); parar(); delay(700);",
  "",
  "  Serial.println(\"Fim do teste.\");",
  "}",
  ""
 ],
