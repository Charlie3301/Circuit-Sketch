{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "MQTT on the ESP32: publishes a count and obeys a command.",
  "",
  "What this demo shows:",
  "- PubSubClient connecting, subscribing to \"class/led\" and publishing to",
  "  \"class/sensor\" every 3 s;",
  "- without internet, CircuitSketch's own broker stands in for",
  "  broker.hivemq.com.",
  "",
  "Press F5 and, in the NETWORK panel, publish \"on\" or \"off\" to class/led."
 ],
 "codigo": [
  "// MQTT on the ESP32: publishes a value and obeys a command.",
  "//",
  "// Without internet, CircuitSketch uses its own broker. In the NETWORK",
  "// panel, publish \"on\" or \"off\" to \"class/led\" and watch the LED.",
  "#include <WiFi.h>",
  "#include <PubSubClient.h>",
  "",
  "const int LED = 14;",
  "",
  "WiFiClient espClient;",
  "PubSubClient client(espClient);",
  "",
  "unsigned long lastSend = 0;",
  "int counter = 0;",
  "",
  "void received(char* topic, byte* payload, unsigned int length) {",
  "  String message;",
  "  for (int i = 0; i < length; i++) {",
  "    message += (char)payload[i];",
  "  }",
  "  Serial.println(String(topic) + \" -> \" + message);",
  "",
  "  if (message == \"on\")  digitalWrite(LED, HIGH);",
  "  if (message == \"off\") digitalWrite(LED, LOW);",
  "}",
  "",
  "void connectToBroker() {",
  "  // One id per board: on the public broker, two boards with the same id",
  "  // knock each other off -- and the whole class runs this same sketch.",
  "  // The board's MAC is different on each one.",
  "  String id = \"circuitsketch-\" + WiFi.macAddress();",
  "  id.replace(\":\", \"\");",
  "",
  "  while (!client.connected()) {",
  "    Serial.print(\"connecting to the broker... \");",
  "    if (client.connect(id.c_str())) {",
  "      Serial.println(\"ok\");",
  "      client.subscribe(\"class/led\");",
  "    } else {",
  "      Serial.print(\"failed, state=\");",
  "      Serial.println(client.state());",
  "      delay(2000);",
  "    }",
  "  }",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(LED, OUTPUT);",
  "",
  "  WiFi.begin(\"CircuitSketch-WiFi\", \"12345678\");",
  "  while (WiFi.status() != WL_CONNECTED) {",
  "    delay(300);",
  "  }",
  "  Serial.print(\"board IP: \");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  client.setServer(\"broker.hivemq.com\", 1883);",
  "  client.setCallback(received);",
  "}",
  "",
  "void loop() {",
  "  if (!client.connected()) connectToBroker();",
  "  client.loop();",
  "",
  "  if (millis() - lastSend > 3000) {",
  "    lastSend = millis();",
  "    counter++;",
  "",
  "    char payload[40];",
  "    snprintf(payload, 40, \"count=%d\", counter);",
  "    client.publish(\"class/sensor\", payload);",
  "    Serial.println(payload);",
  "  }",
  "  delay(10);",
  "}"
 ],
