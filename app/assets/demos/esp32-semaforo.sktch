{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Semaforo com tres LEDs, na ESP32.",
  "",
  "O que esta demo mostra:",
  "- tres saidas digitais em sequencia, cada LED com o seu resistor;",
  "- os tempos do semaforo com delay() e o monitor serial acompanhando.",
  "",
  "Aperte F5 e acompanhe as cores no monitor serial."
 ],
 "codigo": [
  "// Semáforo com três LEDs.",
  "// Cada LED tem um resistor de 220 ohms em série.",
  "",
  "const int VERMELHO = 14;",
  "const int AMARELO  = 13;",
  "const int VERDE    = 12;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(VERMELHO, OUTPUT);",
  "  pinMode(AMARELO, OUTPUT);",
  "  pinMode(VERDE, OUTPUT);",
  "  Serial.println(\"Semaforo ligado\");",
  "}",
  "",
  "void loop() {",
  "  Serial.println(\"vermelho\");",
  "  digitalWrite(VERMELHO, HIGH); delay(3000); digitalWrite(VERMELHO, LOW);",
  "",
  "  Serial.println(\"verde\");",
  "  digitalWrite(VERDE, HIGH); delay(3000); digitalWrite(VERDE, LOW);",
  "",
  "  Serial.println(\"amarelo\");",
  "  digitalWrite(AMARELO, HIGH); delay(1000); digitalWrite(AMARELO, LOW);",
  "}"
 ],
