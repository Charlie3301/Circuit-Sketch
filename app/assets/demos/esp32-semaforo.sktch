{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Traffic light with three LEDs, on the ESP32.",
  "",
  "What this demo shows:",
  "- three digital outputs in sequence, each LED with its own resistor;",
  "- the traffic light timing with delay() and the serial monitor following",
  "  along.",
  "",
  "Press F5 and follow the colors in the serial monitor."
 ],
 "codigo": [
  "// Traffic light with three LEDs.",
  "// Each LED has a 220 ohm resistor in series.",
  "",
  "const int RED    = 14;",
  "const int YELLOW = 13;",
  "const int GREEN  = 12;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(RED, OUTPUT);",
  "  pinMode(YELLOW, OUTPUT);",
  "  pinMode(GREEN, OUTPUT);",
  "  Serial.println(\"Traffic light on\");",
  "}",
  "",
  "void loop() {",
  "  Serial.println(\"red\");",
  "  digitalWrite(RED, HIGH); delay(3000); digitalWrite(RED, LOW);",
  "",
  "  Serial.println(\"green\");",
  "  digitalWrite(GREEN, HIGH); delay(3000); digitalWrite(GREEN, LOW);",
  "",
  "  Serial.println(\"yellow\");",
  "  digitalWrite(YELLOW, HIGH); delay(1000); digitalWrite(YELLOW, LOW);",
  "}"
 ],
