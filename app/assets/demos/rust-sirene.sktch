    "X": 640,
    "Y": 20,
    "Cor": "azul"
   },
   {
    "Id": "r_giro_b",
    "Tipo": "resistor",
    "X": 568,
    "Y": 66,
    "Ohms": 220
   }
  ],
  "Fios": [
