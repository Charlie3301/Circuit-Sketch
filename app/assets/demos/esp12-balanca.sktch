    "ParaPeca": "tara",
    "ParaPino": "1.l",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "tara",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}