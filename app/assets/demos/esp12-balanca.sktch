    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "celula",
    "DePino": "DT",
    "ParaPeca": "placa",
    "ParaPino": "GPIO12",
    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "celula",
    "DePino": "SCK",
    "ParaPeca": "placa",
    "ParaPino": "GPIO14",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "celula",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "oled",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "oled",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "VCC",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "oled",
