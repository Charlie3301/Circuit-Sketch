    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "rtc",
    "DePino": "SCL",
    "ParaPeca": "placa",
    "ParaPino": "D15",
    "Cor": "#8E44AD",
    "Estilo": "solto"
   },
   {
    "DePeca": "lcd",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.2",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "lcd",
