    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "rtc",
    "DePino": "5V",
    "ParaPeca": "placa",
    "ParaPino": "5V",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "rtc",
    "DePino": "SDA",
    "ParaPeca": "placa",
