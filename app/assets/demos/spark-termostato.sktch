    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "pot",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.2",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "8",
    "ParaPeca": "r_aquecedor",
    "ParaPino": "1",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_aquecedor",
    "DePino": "2",
    "ParaPeca": "aquecedor",
    "ParaPino": "A",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "aquecedor",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}