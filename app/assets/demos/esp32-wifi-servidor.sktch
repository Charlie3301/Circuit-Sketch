{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Servidor web na ESP32: a pagina liga e desliga os LEDs.",
  "",
  "O que esta demo mostra:",
  "- a placa no WiFi servindo uma pagina com links, cada um numa rota",
  "  (server.on) que acende um LED;",
  "- o endereco da placa e a ponte para o navegador deste computador.",
  "",
  "Aperte F5 e abra o endereco que aparece no painel REDE."
 ],
 "codigo": [
  "// Servidor web na ESP32: a pagina liga e desliga os LEDs.",
  "//",
  "// Com a simulacao rodando, o painel REDE mostra o endereco",
  "// (http://localhost:8080) para abrir no navegador deste computador.",
  "#include <WiFi.h>",
  "#include <WebServer.h>",
  "",
  "const int VERMELHO = 14;",
  "const int AMARELO  = 13;",
  "const int VERDE    = 12;",
  "",
  "WebServer server(80);",
  "",
  "String pagina() {",
  "  String html = \"<!DOCTYPE html><html><head><meta charset='utf-8'>\";",
  "  html += \"<title>CircuitSketch</title></head><body>\";",
  "  html += \"<h2>Semaforo pela rede</h2>\";",
  "  html += \"<p><a href='/vermelho'>vermelho</a> | \";",
  "  html += \"<a href='/amarelo'>amarelo</a> | \";",
  "  html += \"<a href='/verde'>verde</a> | \";",
  "  html += \"<a href='/apagar'>apagar</a></p>\";",
  "  html += \"</body></html>\";",
  "  return html;",
  "}",
  "",
  "void apagarTudo() {",
  "  digitalWrite(VERMELHO, LOW);",
  "  digitalWrite(AMARELO, LOW);",
  "  digitalWrite(VERDE, LOW);",
  "}",
  "",
  "void acender(int pino) {",
  "  apagarTudo();",
  "  digitalWrite(pino, HIGH);",
  "  server.send(200, \"text/html\", pagina());",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(VERMELHO, OUTPUT);",
  "  pinMode(AMARELO, OUTPUT);",
  "  pinMode(VERDE, OUTPUT);",
  "",
  "  WiFi.begin(\"CircuitSketch-WiFi\", \"12345678\");",
  "  Serial.print(\"conectando\");",
  "  while (WiFi.status() != WL_CONNECTED) {",
  "    delay(300);",
  "    Serial.print(\".\");",
  "  }",
  "  Serial.println();",
  "  Serial.print(\"IP da placa: \");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  server.on(\"/\", []() { server.send(200, \"text/html\", pagina()); });",
  "  server.on(\"/vermelho\", []() { acender(VERMELHO); });",
  "  server.on(\"/amarelo\", []() { acender(AMARELO); });",
  "  server.on(\"/verde\", []() { acender(VERDE); });",
  "  server.on(\"/apagar\", []() { apagarTudo(); server.send(200, \"text/html\", pagina()); });",
  "  server.begin();",
  "",
  "  Serial.println(\"abra o endereco que aparece no painel REDE\");",
  "}",
  "",
  "void loop() {",
  "  server.handleClient();",
  "  delay(2);",
  "}",
  ""
 ],
