{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Web server on the ESP32: the page turns the LEDs on and off.",
  "",
  "What this demo shows:",
  "- the board on WiFi serving a page with links, each on its own route",
  "  (server.on) that lights an LED;",
  "- the board's address and the bridge to this computer's browser.",
  "",
  "Press F5 and open the address shown in the NETWORK panel."
 ],
 "codigo": [
  "// Web server on the ESP32: the page turns the LEDs on and off.",
  "//",
  "// With the simulation running, the NETWORK panel shows the address",
  "// (http://localhost:8080) to open in this computer's browser.",
  "#include <WiFi.h>",
  "#include <WebServer.h>",
  "",
  "const int RED    = 14;",
  "const int YELLOW = 13;",
  "const int GREEN  = 12;",
  "",
  "WebServer server(80);",
  "",
  "String page() {",
  "  String html = \"<!DOCTYPE html><html><head><meta charset='utf-8'>\";",
  "  html += \"<title>CircuitSketch</title></head><body>\";",
  "  html += \"<h2>Traffic light over the network</h2>\";",
  "  html += \"<p><a href='/red'>red</a> | \";",
  "  html += \"<a href='/yellow'>yellow</a> | \";",
  "  html += \"<a href='/green'>green</a> | \";",
  "  html += \"<a href='/off'>off</a></p>\";",
  "  html += \"</body></html>\";",
  "  return html;",
  "}",
  "",
  "void allOff() {",
  "  digitalWrite(RED, LOW);",
  "  digitalWrite(YELLOW, LOW);",
  "  digitalWrite(GREEN, LOW);",
  "}",
  "",
  "void lightUp(int pin) {",
  "  allOff();",
  "  digitalWrite(pin, HIGH);",
  "  server.send(200, \"text/html\", page());",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(RED, OUTPUT);",
  "  pinMode(YELLOW, OUTPUT);",
  "  pinMode(GREEN, OUTPUT);",
  "",
  "  WiFi.begin(\"CircuitSketch-WiFi\", \"12345678\");",
  "  Serial.print(\"connecting\");",
  "  while (WiFi.status() != WL_CONNECTED) {",
  "    delay(300);",
  "    Serial.print(\".\");",
  "  }",
  "  Serial.println();",
  "  Serial.print(\"board IP: \");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  server.on(\"/\", []() { server.send(200, \"text/html\", page()); });",
  "  server.on(\"/red\", []() { lightUp(RED); });",
  "  server.on(\"/yellow\", []() { lightUp(YELLOW); });",
  "  server.on(\"/green\", []() { lightUp(GREEN); });",
  "  server.on(\"/off\", []() { allOff(); server.send(200, \"text/html\", page()); });",
  "  server.begin();",
  "",
  "  Serial.println(\"open the address shown in the NETWORK panel\");",
  "}",
  "",
  "void loop() {",
  "  server.handleClient();",
  "  delay(2);",
  "}"
 ],
