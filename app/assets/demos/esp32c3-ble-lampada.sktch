{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Lampada BLE: o celular controla a ESP32-C3 pelo Bluetooth LE.",
  "",
  "A C3 so tem o BLE -- o Bluetooth classico do SerialBT e so da ESP32 --, e",
  "e ele que os apps de celular de hoje usam. Dois jeitos de conversar:",
  "",
  "- o UART (Nordic UART Service): mande \"vermelho\", \"verde\", \"azul\",",
  "  \"branco\", \"apagar\" ou \"temp\", e a placa responde por notificacao;",
  "- a temperatura do DHT22 na caracteristica padrao 0x2A6E: ligue as",
  "  notificacoes e ela chega a cada 2 segundos, em centesimos de grau.",
  "",
  "Aperte F5: a janela do celular abre sozinha. Em Dispositivos, conecte na",
  "\"ESP32-C3 Lampada\"; a conversa (UART) ja abre, e o botao da conversa",
  "troca para os servicos e as caracteristicas, como no nRF Connect."
 ],
 "codigo": [
  "// Lampada BLE: o celular controla a ESP32-C3 pelo Bluetooth LE.",
  "//",
  "// A C3 so tem o BLE (o Bluetooth classico do SerialBT e so da ESP32), e e o",
  "// jeito de falar com os apps de celular de hoje. Dois jeitos de conversar:",
  "//",
  "//   - pelo UART (o servico Nordic UART, que todo app de terminal BLE",
  "//     conhece): mande \"vermelho\", \"verde\", \"azul\", \"branco\", \"apagar\" ou",
  "//     \"temp\", e a placa responde por notificacao;",
  "//   - pela caracteristica de temperatura (0x2A6E, a padrao do Bluetooth):",
  "//     ligue as notificacoes e a temperatura chega a cada 2 segundos, em",
  "//     centesimos de grau.",
  "//",
  "// No simulador, o celular e a janela do celular (painel Bluetooth > Abrir o",
  "// celular). Na placa, qualquer app de BLE: nRF Connect, \"Serial Bluetooth",
  "// Terminal\" (modo BLE), LightBlue.",
  "",
  "#include <BLEDevice.h>",
  "#include <BLEServer.h>",
  "#include <BLEUtils.h>",
  "#include <BLE2902.h>",
  "#include <DHT.h>",
  "",
  "#define PINO_DHT 4",
  "#define PINO_R 5",
  "#define PINO_G 6",
  "#define PINO_B 7",
  "",
  "#define UART_SERVICO \"6E400001-B5A3-F393-E0A9-E50E24DCCA9E\"",
  "#define UART_RX      \"6E400002-B5A3-F393-E0A9-E50E24DCCA9E\"  // o celular escreve aqui",
  "#define UART_TX      \"6E400003-B5A3-F393-E0A9-E50E24DCCA9E\"  // a placa notifica por aqui",
  "",
  "DHT dht(PINO_DHT, DHT22);",
  "BLECharacteristic *uartTx;",
  "BLECharacteristic *temperatura;",
  "bool conectado = false;",
  "String comando = \"\";",
  "unsigned long ultimaLeitura = 0;",
  "",
  "void cor(int r, int g, int b) {",
  "  digitalWrite(PINO_R, r);",
  "  digitalWrite(PINO_G, g);",
  "  digitalWrite(PINO_B, b);",
  "}",
  "",
  "void responder(String texto) {",
  "  if (!conectado) return;",
  "  uartTx->setValue(texto + \"\\n\");",
  "  uartTx->notify();",
  "}",
  "",
  "class AoConectar : public BLEServerCallbacks {",
  "  void onConnect(BLEServer *servidor) {",
  "    conectado = true;",
  "    Serial.println(\"celular conectou\");",
  "  }",
  "  void onDisconnect(BLEServer *servidor) {",
  "    conectado = false;",
  "    Serial.println(\"celular saiu\");",
  "    BLEDevice::startAdvertising();  // volta a aparecer para o celular",
  "  }",
  "};",
  "",
  "class AoEscrever : public BLECharacteristicCallbacks {",
  "  void onWrite(BLECharacteristic *c) {",
  "    // Aqui e a tarefa do Bluetooth: so guarda, e o loop() trata.",
  "    comando = c->getValue();",
  "    comando.trim();",
  "    comando.toLowerCase();",
  "  }",
  "};",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(PINO_R, OUTPUT);",
  "  pinMode(PINO_G, OUTPUT);",
  "  pinMode(PINO_B, OUTPUT);",
  "  dht.begin();",
  "",
  "  BLEDevice::init(\"ESP32-C3 Lampada\");",
  "  BLEServer *servidor = BLEDevice::createServer();",
  "  servidor->setCallbacks(new AoConectar());",
  "",
  "  // O UART: a conversa em texto.",
  "  BLEService *uart = servidor->createService(UART_SERVICO);",
  "  uartTx = uart->createCharacteristic(UART_TX, BLECharacteristic::PROPERTY_NOTIFY);",
  "  uartTx->addDescriptor(new BLE2902());",
  "  BLECharacteristic *uartRx = uart->createCharacteristic(UART_RX, BLECharacteristic::PROPERTY_WRITE);",
  "  uartRx->setCallbacks(new AoEscrever());",
  "  uart->start();",
  "",
  "  // A temperatura, do jeito padrao do Bluetooth (servico 0x181A).",
  "  BLEService *ambiente = servidor->createService(BLEUUID((uint16_t)0x181A));",
  "  temperatura = ambiente->createCharacteristic(BLEUUID((uint16_t)0x2A6E),",
  "                                               BLECharacteristic::PROPERTY_READ | BLECharacteristic::PROPERTY_NOTIFY);",
  "  temperatura->addDescriptor(new BLE2902());",
  "  ambiente->start();",
  "",
  "  BLEAdvertising *anuncio = BLEDevice::getAdvertising();",
  "  anuncio->addServiceUUID(UART_SERVICO);",
  "  anuncio->setScanResponse(true);",
  "  BLEDevice::startAdvertising();",
  "  Serial.println(\"anunciando: procure \\\"ESP32-C3 Lampada\\\" no celular\");",
  "}",
  "",
  "void loop() {",
  "  if (comando.length() > 0) {",
  "    String c = comando;",
  "    comando = \"\";",
  "    Serial.println(\"comando: \" + c);",
  "    if (c == \"vermelho\") { cor(HIGH, LOW, LOW); responder(\"LED vermelho\"); }",
  "    else if (c == \"verde\") { cor(LOW, HIGH, LOW); responder(\"LED verde\"); }",
  "    else if (c == \"azul\") { cor(LOW, LOW, HIGH); responder(\"LED azul\"); }",
  "    else if (c == \"branco\") { cor(HIGH, HIGH, HIGH); responder(\"LED branco\"); }",
  "    else if (c == \"apagar\") { cor(LOW, LOW, LOW); responder(\"LED apagado\"); }",
  "    else if (c == \"temp\") responder(\"temperatura: \" + String(dht.readTemperature(), 1) + \" C\");",
  "    else responder(\"nao conheco '\" + c + \"'. Mande: vermelho, verde, azul, branco, apagar ou temp\");",
  "  }",
  "",
  "  // A cada 2 s, a temperatura na caracteristica padrao: centesimos de grau",
  "  // num int16, que e o formato da 0x2A6E.",
  "  if (millis() - ultimaLeitura >= 2000) {",
  "    ultimaLeitura = millis();",
  "    int16_t centesimos = (int16_t)(dht.readTemperature() * 100);",
  "    temperatura->setValue((uint8_t *)&centesimos, 2);",
  "    if (conectado) temperatura->notify();",
  "  }",
  "  delay(20);",
  "}"
 ],
 "circuito": {
