    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO13",
    "ParaPeca": "zerar",
    "ParaPino": "1.l",
    "Cor": "#8A8A8A",
    "Estilo": "solto"
   },
   {
    "DePeca": "zerar",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO16",
    "ParaPeca": "buzzer",
    "ParaPino": "2",
    "Cor": "#F28C28",
    "Estilo": "solto"
   },
   {
    "DePeca": "buzzer",
    "DePino": "1",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}