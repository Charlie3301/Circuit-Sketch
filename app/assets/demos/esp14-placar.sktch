    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "oled",
    "DePino": "SCL",
    "ParaPeca": "placa",
    "ParaPino": "GPIO5",
    "Cor": "#8E44AD",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO14",
    "ParaPeca": "time_a",
    "ParaPino": "1.l",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "time_a",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
