{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Breathing LED in Millipascal.",
  "",
  "What this demo shows:",
  "- typed variables, \"set\" to assign and blocks with begin/end;",
  "- PWM with analogWrite on the Uno's pin 9.",
  "",
  "Press F5 and watch the LED breathe."
 ],
 "codigo": [
  "# Breathing LED in Millipascal.",
  "#",
  "# analogWrite goes from 0 to 255 and back: the LED on pin 9 (which has PWM)",
  "# slowly brightens and dims, like breathing.",
  "#",
  "# Millipascal is a lean Pascal: \"proc\" opens the procedure, \"begin\" and",
  "# \"end\" delimit the blocks, and \"set\" assigns.",
  "",
  "proc main",
  "var level:i32, change:i32",
  "begin",
  "    pin_mode(9, OUTPUT);",
  "    set level = 0;",
  "    set change = 5;",
  "",
  "    while true begin",
  "        analog_write(9, level);",
  "        set level = level + change;",
  "        if level >= 255 or level <= 0 begin",
  "            set change = 0 - change;",
  "        end",
  "        delay_ms(30);",
  "    end",
  "end proc"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 60,
    "Y": 160
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 460,
    "Y": 30,
    "Cor": "azul"
   },
   {
    "Id": "r_led",
    "Tipo": "resistor",
    "X": 388,
    "Y": 76,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "9",
    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}