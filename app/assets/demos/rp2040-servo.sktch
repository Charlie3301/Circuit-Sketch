{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Servo driven by a potentiometer, on the Arduino Nano RP2040 Connect.",
  "",
  "What this demo shows:",
  "- Servo.h: the servo's angle follows the potentiometer reading;",
  "- the RP2040 programmed with the Arduino core.",
  "",
  "Press F5 and turn the potentiometer."
 ],
 "codigo": [
  "// The potentiometer sets the servo's angle.",
  "",
  "#include <Servo.h>",
  "",
  "Servo arm;",
  "const int POT = A0;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  arm.attach(9);",
  "}",
  "",
  "void loop() {",
  "  int reading = analogRead(POT);",
  "  int angle = map(reading, 0, 1023, 0, 180);",
  "  arm.write(angle);",
  "",
  "  Serial.print(\"angle=\");",
  "  Serial.println(angle);",
  "  delay(100);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "bb",
    "Tipo": "protoboard-830",
    "X": 40,
    "Y": 320
   },
   {
    "Id": "placa",
    "Tipo": "nano-rp2040-connect",
    "X": 60,
    "Y": 20
   },
   {
    "Id": "servo",
    "Tipo": "servo",
    "X": 520,
    "Y": 60
   },
   {
    "Id": "pot",
    "Tipo": "potentiometer",
    "X": 520,
    "Y": 200,
    "Giro": 0.5
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "D9",
    "ParaPeca": "servo",
    "ParaPino": "PWM",
    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "5V",
    "ParaPeca": "servo",
    "ParaPino": "V+",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "servo",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "3.3V",
    "ParaPeca": "pot",
    "ParaPino": "VCC",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "pot",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.2",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "pot",
    "DePino": "SIG",
    "ParaPeca": "placa",
    "ParaPino": "A0",
    "Cor": "#00A651",
    "Estilo": "solto"
   }
  ]
 }
}