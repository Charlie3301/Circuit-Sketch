{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Button and LED, on the Arduino Uno.",
  "",
  "What this demo shows:",
  "- the button with INPUT_PULLUP: released it reads HIGH, pressed it reads",
  "  LOW -- that is why the test is \"== LOW\";",
  "- the circuit built on the breadboard, with the LED and the resistor",
  "  plugged in.",
  "",
  "Press F5 and hold the button."
 ],
 "codigo": [
  "// A button lights the LED.",
  "// The button uses the internal pull-up resistor: released it reads HIGH,",
  "// pressed it reads LOW. That is why the test is \"== LOW\".",
  "",
  "const int BUTTON = 2;",
  "const int LED    = 13;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  pinMode(BUTTON, INPUT_PULLUP);",
  "  pinMode(LED, OUTPUT);",
  "}",
  "",
  "void loop() {",
  "  if (digitalRead(BUTTON) == LOW) {",
  "    digitalWrite(LED, HIGH);",
  "  } else {",
  "    digitalWrite(LED, LOW);",
  "  }",
  "  delay(20);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "bb",
    "Tipo": "protoboard-830",
    "X": 40,
    "Y": 300
   },
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 40,
    "Y": 20
   },
   {
    "Id": "bt",
    "Tipo": "pushbutton",
    "X": 109.5,
    "Y": 386.4,
    "Rotacao": 90
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 216.6,
    "Y": 315.6,
    "Cor": "verde"
   },
   {
    "Id": "r",
    "Tipo": "resistor",
    "X": 232.0,
    "Y": 371.15,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "2",
    "ParaPeca": "bb",
    "ParaPino": "A8",
    "Cor": "#2B59BF",
    "Estilo": "solto"
   },
   {
    "DePeca": "bb",
    "DePino": "H10",
    "ParaPeca": "placa",
