    "ParaPeca": "teclado",
    "ParaPino": "R4",
    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO4",
    "ParaPeca": "teclado",
    "ParaPino": "C1",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO0",
    "ParaPeca": "teclado",
    "ParaPino": "C2",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
