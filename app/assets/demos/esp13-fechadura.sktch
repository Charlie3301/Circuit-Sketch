    "Tipo": "membrane-keypad",
    "X": 300,
    "Y": 10
   },
   {
    "Id": "aberta",
    "Tipo": "led",
    "X": 170,
    "Y": 260,
    "Cor": "verde"
   },
   {
    "Id": "r_aberta",
    "Tipo": "resistor",
    "X": 98,
    "Y": 306,
    "Ohms": 220
   },
   {
    "Id": "buzzer",
    "Tipo": "buzzer",
    "X": 60,
    "Y": 260
   }
  ],
  "Fios": [
