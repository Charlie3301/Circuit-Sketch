{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Servidor web na NodeMCU (ESP8266).",
  "",
  "O que esta demo mostra:",
  "- uma pagina servida pela propria placa, com links que acendem o LED e o",
  "  estado do botao atualizado a cada 2 s;",
  "- os nomes D5 e D6 da serigrafia, que o core do ESP8266 traduz para os",
  "  GPIO de verdade.",
  "",
  "Aperte F5 e abra no navegador o endereco que aparece no painel REDE."
 ],
 "codigo": [
  "// Servidor web na NodeMCU (ESP8266).",
  "//",
  "// A pagina mostra se o botao esta apertado e liga e desliga o LED. Ela se",
  "// atualiza sozinha a cada 2 s: aperte o botao e veja a pagina mudar.",
  "//",
  "// Repare nos nomes: D5 e D6 sao os da serigrafia da NodeMCU, e o core do",
  "// ESP8266 os traduz para os GPIO 14 e 12.",
  "",
  "#include <ESP8266WiFi.h>",
  "#include <ESP8266WebServer.h>",
  "",
  "const int LED = D5;",
  "const int BOTAO = D6;",
  "",
  "ESP8266WebServer servidor(80);",
  "bool ledLigado = false;",
  "",
  "String pagina() {",
  "  String html = \"<!DOCTYPE html><html><head><meta charset='utf-8'>\";",
  "  html += \"<meta http-equiv='refresh' content='2'>\";",
  "  html += \"<title>NodeMCU</title></head><body style='font-family:sans-serif'>\";",
  "  html += \"<h2>NodeMCU na rede</h2>\";",
  "  html += \"<p>Botao: <b>\";",
  "  html += digitalRead(BOTAO) == LOW ? \"APERTADO\" : \"solto\";",
  "  html += \"</b></p><p>LED: <b>\";",
  "  html += ledLigado ? \"aceso\" : \"apagado\";",
  "  html += \"</b></p>\";",
  "  html += \"<p><a href='/ligar'>Ligar</a> | <a href='/desligar'>Desligar</a></p>\";",
  "  html += \"<p>Ligada ha \";",
  "  html += millis() / 1000;",
  "  html += \" s</p></body></html>\";",
  "  return html;",
  "}",
  "",
  "void responder() {",
  "  servidor.send(200, \"text/html\", pagina());",
  "}",
  "",
  "void ligar() {",
  "  ledLigado = true;",
  "  digitalWrite(LED, HIGH);",
  "  responder();",
  "}",
  "",
  "void desligar() {",
  "  ledLigado = false;",
  "  digitalWrite(LED, LOW);",
  "  responder();",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(LED, OUTPUT);",
  "  pinMode(BOTAO, INPUT_PULLUP);",
  "",
  "  WiFi.mode(WIFI_STA);",
  "  WiFi.begin(\"Wokwi-GUEST\", \"\");",
  "  Serial.print(\"conectando\");",
  "  while (WiFi.status() != WL_CONNECTED) {",
  "    delay(300);",
  "    Serial.print(\".\");",
  "  }",
  "  Serial.println();",
  "  Serial.print(\"IP: \");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  servidor.on(\"/\", responder);",
  "  servidor.on(\"/ligar\", ligar);",
  "  servidor.on(\"/desligar\", desligar);",
  "  servidor.begin();",
  "  Serial.println(\"servidor no ar: abra o endereco do painel REDE\");",
  "}",
  "",
  "void loop() {",
  "  servidor.handleClient();",
  "  delay(2);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp8266-nodemcu",
    "X": 60,
    "Y": 60
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 320,
    "Y": 60,
    "Cor": "verde"
   },
   {
    "Id": "r_led",
    "Tipo": "resistor",
    "X": 248,
    "Y": 106,
    "Ohms": 220
   },
   {
    "Id": "botao",
    "Tipo": "pushbutton",
    "X": 300,
    "Y": 180
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "D5",
    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.3",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "D6",
    "ParaPeca": "botao",
    "ParaPino": "1.l",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "botao",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND.3",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}