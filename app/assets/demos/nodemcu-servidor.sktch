{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Web server on the NodeMCU (ESP8266).",
  "",
  "What this demo shows:",
  "- a page served by the board itself, with links that light the LED and",
  "  the button state refreshed every 2 s;",
  "- the D5 and D6 names printed on the board, which the ESP8266 core",
  "  translates to the real GPIO.",
  "",
  "Press F5 and open the address shown in the NETWORK panel in a browser."
 ],
 "codigo": [
  "// Web server on the NodeMCU (ESP8266).",
  "//",
  "// The page shows whether the button is pressed and turns the LED on and",
  "// off. It refreshes itself every 2 s: press the button and watch the page",
  "// change.",
  "//",
  "// Note the names: D5 and D6 are the ones printed on the NodeMCU, and the",
  "// ESP8266 core translates them to GPIO 14 and 12.",
  "",
  "#include <ESP8266WiFi.h>",
  "#include <ESP8266WebServer.h>",
  "",
  "const int LED = D5;",
  "const int BUTTON = D6;",
  "",
  "ESP8266WebServer server(80);",
  "bool ledOn = false;",
  "",
  "String page() {",
  "  String html = \"<!DOCTYPE html><html><head><meta charset='utf-8'>\";",
  "  html += \"<meta http-equiv='refresh' content='2'>\";",
  "  html += \"<title>NodeMCU</title></head><body style='font-family:sans-serif'>\";",
  "  html += \"<h2>NodeMCU on the network</h2>\";",
  "  html += \"<p>Button: <b>\";",
  "  html += digitalRead(BUTTON) == LOW ? \"PRESSED\" : \"released\";",
  "  html += \"</b></p><p>LED: <b>\";",
  "  html += ledOn ? \"on\" : \"off\";",
  "  html += \"</b></p>\";",
  "  html += \"<p><a href='/on'>Turn on</a> | <a href='/off'>Turn off</a></p>\";",
  "  html += \"<p>Up for \";",
  "  html += millis() / 1000;",
  "  html += \" s</p></body></html>\";",
  "  return html;",
  "}",
  "",
  "void respond() {",
  "  server.send(200, \"text/html\", page());",
  "}",
  "",
  "void turnOn() {",
  "  ledOn = true;",
  "  digitalWrite(LED, HIGH);",
  "  respond();",
  "}",
  "",
  "void turnOff() {",
  "  ledOn = false;",
  "  digitalWrite(LED, LOW);",
  "  respond();",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(LED, OUTPUT);",
  "  pinMode(BUTTON, INPUT_PULLUP);",
  "",
  "  WiFi.mode(WIFI_STA);",
  "  WiFi.begin(\"Wokwi-GUEST\", \"\");",
  "  Serial.print(\"connecting\");",
  "  while (WiFi.status() != WL_CONNECTED) {",
  "    delay(300);",
  "    Serial.print(\".\");",
  "  }",
  "  Serial.println();",
  "  Serial.print(\"IP: \");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  server.on(\"/\", respond);",
  "  server.on(\"/on\", turnOn);",
  "  server.on(\"/off\", turnOff);",
  "  server.begin();",
  "  Serial.println(\"server is up: open the address in the NETWORK panel\");",
  "}",
  "",
  "void loop() {",
  "  server.handleClient();",
  "  delay(2);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp8266-nodemcu",
    "X": 60,
    "Y": 60
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 320,
    "Y": 60,
    "Cor": "verde"
   },
   {
    "Id": "r_led",
    "Tipo": "resistor",
    "X": 248,
    "Y": 106,
    "Ohms": 220
   },
   {
    "Id": "botao",
    "Tipo": "pushbutton",
    "X": 300,
    "Y": 180
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "D5",
    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.3",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "D6",
    "ParaPeca": "botao",
    "ParaPino": "1.l",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "botao",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND.3",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}