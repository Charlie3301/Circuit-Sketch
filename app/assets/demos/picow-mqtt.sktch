    "ParaPeca": "r_led",
    "ParaPino": "1",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_led",
    "DePino": "2",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "placa",
