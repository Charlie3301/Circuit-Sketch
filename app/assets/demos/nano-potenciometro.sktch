{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Potentiometer controlling an LED's brightness, on the Arduino Nano.",
  "",
  "What this demo shows:",
  "- analogRead (0 to 1023) turned into analogWrite (0 to 255) with map();",
  "- PWM on pin 9, one of the Nano's PWM pins.",
  "",
  "Press F5 and turn the potentiometer."
 ],
 "codigo": [
  "// The potentiometer controls the LED's brightness.",
  "// analogRead returns 0..1023 and analogWrite expects 0..255,",
  "// hence the map.",
  "",
  "const int POT = A0;",
  "const int LED = 9;   // a PWM pin",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  pinMode(LED, OUTPUT);",
  "}",
  "",
  "void loop() {",
  "  int reading = analogRead(POT);",
  "  int brightness = map(reading, 0, 1023, 0, 255);",
  "  analogWrite(LED, brightness);",
  "",
  "  Serial.print(\"pot=\");",
  "  Serial.print(reading);",
  "  Serial.print(\"  brightness=\");",
  "  Serial.println(brightness);",
  "  delay(200);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "bb",
    "Tipo": "protoboard-830",
    "X": 40,
    "Y": 300
   },
   {
    "Id": "placa",
    "Tipo": "arduino-nano",
    "X": 60,
    "Y": 20
   },
   {
    "Id": "pot",
    "Tipo": "potentiometer",
    "X": 520,
    "Y": 40,
    "Giro": 0.35
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 159.0,
    "Y": 315.6,
    "Cor": "azul"
   },
   {
    "Id": "r",
    "Tipo": "resistor",
    "X": 174.4,
    "Y": 371.15,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "5V",
    "ParaPeca": "pot",
