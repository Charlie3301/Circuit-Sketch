{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Potenciometro controlando o brilho de um LED, no Arduino Nano.",
  "",
  "O que esta demo mostra:",
  "- analogRead (0 a 1023) virando analogWrite (0 a 255) com map();",
  "- PWM no pino 9, que e um dos que tem PWM no Nano.",
  "",
  "Aperte F5 e gire o potenciometro."
 ],
 "codigo": [
  "// O potenciômetro controla o brilho do LED.",
  "// analogRead devolve 0..1023 e analogWrite espera 0..255,",
  "// por isso o map.",
  "",
  "const int POT = A0;",
  "const int LED = 9;   // pino com PWM",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  pinMode(LED, OUTPUT);",
  "}",
  "",
  "void loop() {",
  "  int leitura = analogRead(POT);",
  "  int brilho = map(leitura, 0, 1023, 0, 255);",
  "  analogWrite(LED, brilho);",
  "",
  "  Serial.print(\"pot=\");",
  "  Serial.print(leitura);",
  "  Serial.print(\"  brilho=\");",
  "  Serial.println(brilho);",
  "  delay(200);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "bb",
    "Tipo": "protoboard-830",
    "X": 40,
    "Y": 300
   },
   {
    "Id": "placa",
    "Tipo": "arduino-nano",
    "X": 60,
    "Y": 20
   },
   {
    "Id": "pot",
    "Tipo": "potentiometer",
    "X": 520,
    "Y": 40,
    "Giro": 0.35
   },
   {
    "Id": "led",
