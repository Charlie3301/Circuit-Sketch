{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "RGB LED color from the browser, on an ESP-12E.",
  "",
  "What this demo shows:",
  "- an HTML color picker sending \"#rrggbb\" to the board;",
  "- strtol() and bit shifts splitting out the red, green and blue.",
  "",
  "Press F5, open the address in the NETWORK panel and pick a color."
 ],
 "codigo": [
  "// RGB LED color from the browser, on an ESP-12E.",
  "//",
  "// The page has a color picker: choose one and click Apply. The board gets",
  "// \"#rrggbb\", splits out the red, green and blue and sends each one to its",
  "// pin with PWM.",
  "",
  "#include <ESP8266WiFi.h>",
  "#include <ESP8266WebServer.h>",
  "",
  "const int PIN_R = 14;",
  "const int PIN_G = 12;",
  "const int PIN_B = 13;",
  "",
  "ESP8266WebServer server(80);",
  "String currentColor = \"#000000\";",
  "",
  "void applyColor(String hex) {",
  "  long value = strtol(hex.substring(1).c_str(), NULL, 16);",
  "  int r = (value >> 16) & 0xFF;",
  "  int g = (value >> 8) & 0xFF;",
  "  int b = value & 0xFF;",
  "  analogWrite(PIN_R, r);",
  "  analogWrite(PIN_G, g);",
  "  analogWrite(PIN_B, b);",
  "  currentColor = hex;",
  "  Serial.printf(\"color %s -> R=%d G=%d B=%d\\n\", hex.c_str(), r, g, b);",
  "}",
  "",
  "void page() {",
  "  if (server.hasArg(\"color\")) applyColor(server.arg(\"color\"));",
  "",
  "  String html = \"<!DOCTYPE html><html><head><meta charset='utf-8'>\";",
  "  html += \"<title>RGB LED</title></head><body style='font-family:sans-serif'>\";",
  "  html += \"<h2>RGB LED from the browser</h2>\";",
  "  html += \"<form action='/'><input type='color' name='color' value='\" + currentColor + \"'> \";",
  "  html += \"<button>Apply</button></form>\";",
  "  html += \"<p>Current color: \" + currentColor + \"</p></body></html>\";",
  "  server.send(200, \"text/html\", html);",
  "}",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  analogWriteRange(255);    // PWM from 0 to 255, like on the Arduino",
  "  WiFi.begin(\"Wokwi-GUEST\", \"\");",
  "  while (WiFi.status() != WL_CONNECTED) delay(250);",
  "  Serial.print(\"open http://\");",
  "  Serial.println(WiFi.localIP());",
  "",
  "  server.on(\"/\", page);",
  "  server.begin();",
  "  applyColor(\"#ff6a00\");    // starts orange",
  "}",
  "",
  "void loop() {",
  "  server.handleClient();",
  "  delay(2);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp-12e",
    "X": 80,
    "Y": 100
   },
   {
    "Id": "rgb",
    "Tipo": "rgb-led",
    "X": 440,
    "Y": 60
   },
   {
    "Id": "r_r",
    "Tipo": "resistor",
    "X": 330,
    "Y": 60,
    "Ohms": 220
   },
   {
    "Id": "r_g",
    "Tipo": "resistor",
    "X": 330,
    "Y": 90,
    "Ohms": 220
   },
   {
    "Id": "r_b",
    "Tipo": "resistor",
    "X": 330,
    "Y": 120,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "GPIO14",
    "ParaPeca": "r_r",
    "ParaPino": "1",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_r",
    "DePino": "2",
    "ParaPeca": "rgb",
    "ParaPino": "R",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO12",
    "ParaPeca": "r_g",
    "ParaPino": "1",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_g",
    "DePino": "2",
    "ParaPeca": "rgb",
    "ParaPino": "G",
    "Cor": "#00A651",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GPIO13",
    "ParaPeca": "r_b",
    "ParaPino": "1",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_b",
    "DePino": "2",
    "ParaPeca": "rgb",
    "ParaPino": "B",
    "Cor": "#1F6FEB",
    "Estilo": "solto"
   },
   {
    "DePeca": "rgb",
    "DePino": "COM",
    "ParaPeca": "placa",
