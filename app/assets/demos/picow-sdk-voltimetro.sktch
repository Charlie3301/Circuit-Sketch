{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Voltmeter with the ADC, on the Raspberry Pi Pico W (C SDK).",
  "",
  "What this demo shows:",
  "- the 12-bit converter through the SDK: adc_select_input and adc_read,",
  "  with the math that turns the reading into volts;",
  "- the temperature sensor inside the RP2040, on channel 4.",
  "",
  "Press F5 and turn the potentiometer. Above 2.5 V the LED lights."
 ],
 "codigo": [
  "// Voltmeter on the Raspberry Pi Pico W, with the C SDK.",
  "//",
  "// The ADC reads the potentiometer voltage on GP26 (channel 0), in 12 bits,",
  "// and printf shows it in volts. Above 2.5 V the alert LED lights. Every",
  "// 2 s, the temperature inside the chip (channel 4) shows up too.",
  "",
  "#include <stdio.h>",
  "#include \"pico/stdlib.h\"",
  "#include \"hardware/adc.h\"",
  "",
  "#define ALERT 15",
  "#define LIMIT 2.5f",
  "",
  "int main() {",
  "    stdio_init_all();",
  "",
  "    gpio_init(ALERT);",
  "    gpio_set_dir(ALERT, GPIO_OUT);",
  "",
  "    adc_init();",
  "    adc_gpio_init(26);",
  "    adc_set_temp_sensor_enabled(true);",
  "",
  "    int rounds = 0;",
  "    while (true) {",
  "        adc_select_input(0);",
  "        uint16_t raw = adc_read();",
  "        float volts = raw * 3.3f / 4096;",
  "        gpio_put(ALERT, volts > LIMIT);",
  "        printf(\"%.2f V (reading %d)%s\\n\", volts, raw, volts > LIMIT ? \"  ALERT\" : \"\");",
  "",
  "        rounds++;",
  "        if (rounds % 8 == 0) {",
  "            adc_select_input(4);",
  "            float degrees = 27 - (adc_read() * 3.3f / 4096 - 0.706f) / 0.001721f;",
  "            printf(\"chip temperature: %.1f C\\n\", degrees);",
  "        }",
  "        sleep_ms(250);",
  "    }",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "pi-pico-w",
    "X": 60,
    "Y": 60
   },
   {
    "Id": "pot",
    "Tipo": "potentiometer",
    "X": 300,
    "Y": 60,
    "Giro": 0.6
   },
   {
    "Id": "alerta",
    "Tipo": "led",
    "X": 330,
    "Y": 200,
    "Cor": "vermelho"
   },
   {
    "Id": "r_alerta",
    "Tipo": "resistor",
    "X": 258,
    "Y": 246,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "pot",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "pot",
    "DePino": "SIG",
    "ParaPeca": "placa",
    "ParaPino": "GP26",
    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "pot",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "AGND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "GP15",
    "ParaPeca": "r_alerta",
    "ParaPino": "1",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_alerta",
    "DePino": "2",
    "ParaPeca": "alerta",
    "ParaPino": "A",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "alerta",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND.4",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}