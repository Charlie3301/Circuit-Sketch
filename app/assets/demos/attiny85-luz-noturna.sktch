{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Automatic night light, on the ATtiny85.",
  "",
  "What this demo shows:",
  "- the bare ATtiny85 chip, with the package names (A3 is PB3);",
  "- the LDR module with real physics: more light, lower reading.",
  "",
  "The demo starts at night (3 lux) and the LED is on. Click the LDR module",
  "and raise the light to watch the LED turn off."
 ],
 "codigo": [
  "// Automatic night light, on the ATtiny85.",
  "//",
  "// The LDR module measures the ambient light. During the day the LED stays",
  "// off; as it gets dark it slowly turns on, and in the dark it is at full",
  "// brightness.",
  "//",
  "// Like the real module: MORE light, LOWER the reading on AO.",
  "",
  "const int SENSOR = A3;   // PB3",
  "const int LED = 0;       // PB0, which has PWM",
  "",
  "void setup() {",
  "  pinMode(LED, OUTPUT);",
  "}",
  "",
  "void loop() {",
  "  int reading = analogRead(SENSOR);   // near 0 in sunlight, near 1023 in the dark",
  "",
  "  // Below 600 it is day: off. From 600 to 1000, it slowly turns on.",
  "  int brightness = 0;",
  "  if (reading > 600) brightness = map(constrain(reading, 600, 1000), 600, 1000, 10, 255);",
  "",
  "  analogWrite(LED, brightness);",
  "  delay(100);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "attiny85",
    "X": 120,
    "Y": 120
   },
   {
    "Id": "ldr",
    "Tipo": "photoresistor-sensor",
    "X": 300,
    "Y": 20,
    "Giro": 0.2461868757866104
   },
   {
    "Id": "luz",
    "Tipo": "led",
    "X": 330,
    "Y": 150,
    "Cor": "branco"
   },
   {
    "Id": "r_luz",
    "Tipo": "resistor",
    "X": 258,
    "Y": 196,
    "Ohms": 220
   }
  ],
  "Fios": [
   {
    "DePeca": "ldr",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "VCC",
    "Cor": "#D6202A",
    "Estilo": "solto"
   },
   {
    "DePeca": "ldr",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "ldr",
    "DePino": "AO",
    "ParaPeca": "placa",
    "ParaPino": "PB3",
    "Cor": "#F2C300",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
    "DePino": "PB0",
    "ParaPeca": "r_luz",
    "ParaPino": "1",
    "Cor": "#E8E8E8",
    "Estilo": "solto"
   },
   {
    "DePeca": "r_luz",
    "DePino": "2",
    "ParaPeca": "luz",
    "ParaPino": "A",
    "Cor": "#E8E8E8",
    "Estilo": "solto"
   },
   {
    "DePeca": "luz",
    "DePino": "C",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   }
  ]
 }
}