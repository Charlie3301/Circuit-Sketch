    "Estilo": "solto"
   },
   {
    "DePeca": "botao",
    "DePino": "2.l",
    "ParaPeca": "placa",
    "ParaPino": "GND",
    "Cor": "#1A1A1A",
    "Estilo": "solto"
   },
   {
    "DePeca": "placa",
