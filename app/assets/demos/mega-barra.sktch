{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Scanning LED bar, on the Arduino Mega.",
  "",
  "What this demo shows:",
  "- ten outputs in a row in a for loop -- the Mega has pins to spare, no",
  "  need to multiplex;",
  "- the LED bar on the breadboard, sweeping back and forth.",
  "",
  "Press F5."
 ],
 "codigo": [
  "// Scanning LED bar.",
  "// The Mega has pins to spare: ten outputs in a row, no multiplexing.",
  "",
  "const int FIRST = 22;",
  "const int COUNT = 10;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  for (int i = 0; i < COUNT; i++) {",
  "    pinMode(FIRST + i, OUTPUT);",
  "  }",
  "}",
  "",
  "void loop() {",
  "  for (int i = 0; i < COUNT; i++) {",
  "    digitalWrite(FIRST + i, HIGH);",
  "    delay(80);",
  "    digitalWrite(FIRST + i, LOW);",
  "  }",
  "  for (int i = COUNT - 2; i > 0; i--) {",
  "    digitalWrite(FIRST + i, HIGH);",
  "    delay(80);",
  "    digitalWrite(FIRST + i, LOW);",
  "  }",
  "}"
 ],
