{
 "formato": "sktch",
 "versao": 1,
 "gerado": "demo do CircuitSketch",
 "descricao": [
  "Barra de LEDs em varredura, no Arduino Mega.",
  "",
  "O que esta demo mostra:",
  "- dez saidas seguidas num laco for -- o Mega tem pinos de sobra, sem",
  "  precisar multiplexar;",
  "- a barra de LEDs na protoboard, indo e voltando.",
  "",
  "Aperte F5."
 ],
 "codigo": [
  "// Barra de LEDs em varredura.",
  "// O Mega tem pinos de sobra: dez saídas seguidas, sem multiplexar.",
  "",
  "const int PRIMEIRO = 22;",
  "const int QUANTOS  = 10;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  for (int i = 0; i < QUANTOS; i++) {",
  "    pinMode(PRIMEIRO + i, OUTPUT);",
  "  }",
  "}",
  "",
  "void loop() {",
  "  for (int i = 0; i < QUANTOS; i++) {",
  "    digitalWrite(PRIMEIRO + i, HIGH);",
  "    delay(80);",
  "    digitalWrite(PRIMEIRO + i, LOW);",
  "  }",
  "  for (int i = QUANTOS - 2; i > 0; i--) {",
  "    digitalWrite(PRIMEIRO + i, HIGH);",
  "    delay(80);",
  "    digitalWrite(PRIMEIRO + i, LOW);",
  "  }",
  "}"
 ],
