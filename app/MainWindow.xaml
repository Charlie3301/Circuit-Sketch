<Window x:Class="Simulador.App.MainWindow"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Simulador.App"
        Title="CircuitSketch"
        Icon="assets/CircuitSketch.ico"
        Height="800" Width="1400"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource Fundo}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Aba do painel de baixo: parece titulo, e acende na escolhida. -->
        <Style x:Key="Modo" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="12,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- As abas de baixo: a mesma pilula das de cima, menor. A escolhida
             ganha o fundo (AtualizarAbas), como a do modo. -->
        <Style x:Key="Aba" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="8,0">
                            <!-- TextBlock explicito, e nao ContentPresenter: o
                                 estilo implicito de TextBlock do app pinta o
                                 texto gerado por ele e a aba escolhida nunca
                                 acendia. -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontStyle="{TemplateBinding FontStyle}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BotaoPequeno, CampoEscuro e BotaoDaAbertura ficam em
             App.xaml: a janela de configuracoes, a de teclas e a de
             abertura tambem precisam deles, e estilo declarado numa
             janela so vale naquela janela. -->

        <Style x:Key="Redondo" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource Borda}"/>
                                <Setter Property="Foreground" Value="#777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao de texto da tab do objeto. Sem isto ele cai no estilo
             padrao do WPF, que tem fundo claro; como a janela e escura e
             manda uma Foreground clara por heranca, sobrava texto claro
             em fundo claro e nao dava para ler o rotulo. -->
        <Style x:Key="AcaoObj" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextoForte}"/>
            <Setter Property="Background" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FerramentaObj" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoForte}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="gradeRaiz" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="420" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= BARRA ================= -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="True">

            <!-- Verificar e Mandar para a placa, no canto direito, com os
                 simbolos da Arduino IDE: o visto e a seta. Mandar e para a
                 placa DE VERDADE, pela USB; o Rodar da esquerda e o
                 simulador. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- A versao nova do GitHub (Atualizacoes.cs): so aparece
                     quando ha uma. Clicar mostra as novidades e o
                     "Atualizar agora"; sem clicar, ela e instalada ao fechar. -->
                <Button x:Name="btAtualizacao" Margin="0,0,12,0" Height="28" MaxWidth="280" VerticalAlignment="Center"
                        Cursor="Hand" Click="AbrirAtualizacao" Visibility="Collapsed"
                        ToolTip="{local:T 'Versão nova do CircuitSketch: ela é instalada quando você fechar o programa. Clique para ver as novidades ou atualizar agora.'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="f" Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Destaque}"
                                    BorderThickness="1" CornerRadius="14" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2B06;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Destaque}"/>
                        <TextBlock x:Name="txtAtualizacao" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Texto}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <!-- O nome do circuito e o autor (o "name" e o "author" do
                     diagram.json), do lado de quem manda o codigo. -->
                <StackPanel x:Name="painelNomeDoCircuito" VerticalAlignment="Center" Margin="0,0,12,0"
                            ToolTip="{local:T 'O nome do circuito e o autor: os mesmos do diagram.json (mudam na aba DESCRIÇÃO ou na do diagram.json)'}">
                    <TextBlock x:Name="txtNomeDoCircuito" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextoForte}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <TextBlock x:Name="txtAutorDoCircuito" FontSize="10"
                               Foreground="{DynamicResource TextoFraco}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                </StackPanel>
                <!-- A placa de verdade que recebe o codigo: a porta USB e o que
                     esta ligado nela, como o "Select Board" da Arduino IDE. -->
                <Button x:Name="btPlacaUsb" Margin="0,0,8,0" Height="28" MaxWidth="250" VerticalAlignment="Center"
                        Cursor="Hand" Click="AbrirMenuDasPortas"
                        ToolTip="{local:T 'A placa de verdade ligada na USB, que recebe o código da seta'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="f" Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}"
                                    BorderThickness="1" CornerRadius="14" Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="USB" FontSize="9" FontWeight="Bold" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"/>
                        <TextBlock DockPanel.Dock="Right" Text="&#x25BE;" FontSize="11" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"/>
                        <TextBlock x:Name="txtPlacaUsb" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Texto}" TextTrimming="CharacterEllipsis"
                                   Text="{local:T 'nenhuma placa na USB'}"/>
                    </DockPanel>
                </Button>
                <Button x:Name="btVerificar" Style="{StaticResource Redondo}" Background="#00878F"
                        Content="&#x2713;" FontSize="17" Click="Verificar"
                        ToolTip="{local:T 'Verificar o código: o simulador e o compilador do Arduino (Ctrl+R)'}"/>
                <Button x:Name="btMandar" Style="{StaticResource Redondo}" Background="#00878F"
                        Content="&#x279C;" FontSize="16" Click="MandarParaPlaca"
                        ToolTip="{local:T 'Mandar para a placa de verdade, pela USB (Ctrl+U)'}"/>
            </StackPanel>

        <StackPanel Orientation="Horizontal">

            <Button x:Name="btRodar" Style="{StaticResource Redondo}"
                    Background="#2FA84F" Content="▶" ToolTip="{local:T 'Rodar a simulação (F5)'}"
                    Click="Rodar"/>
            <Button x:Name="btParar" Style="{StaticResource Redondo}"
                    Background="#C0392B" Content="■" ToolTip="{local:T 'Parar (F5)'}"
                    Click="Parar" IsEnabled="False"/>
            <!-- Depurador. Ficam ao lado do rodar/parar porque sao o mesmo
                 assunto: o que o sketch esta fazendo agora. -->
            <Button x:Name="btPausar" Style="{StaticResource Redondo}" Background="#D68910"
                    Content="❚❚" FontSize="12" ToolTip="{local:T 'Pausar (F6)'}" Click="PausarOuContinuar" IsEnabled="False"/>
            <Button x:Name="btPasso" Style="{StaticResource Redondo}" Background="#7D3C98"
                    Content="▶❚" FontSize="12" ToolTip="{local:T 'Andar uma linha (F10)'}" Click="Passo" IsEnabled="False"/>
            <!-- As variaveis ao vivo: o painel delas atualizando com o sketch rodando, sem pausar. -->
            <Button x:Name="btAoVivo" Style="{StaticResource Redondo}" Background="#117A65"
                    Content="x=" FontSize="12" FontWeight="Bold" Click="AlternarAoVivo" IsEnabled="False"
                    ToolTip="{local:T 'Variáveis ao vivo: ver as variáveis do sketch mudando enquanto ele roda, sem pausar'}"/>
            <Button x:Name="btAdicionar" Style="{StaticResource Redondo}" Background="#1668C1" Content="+"
                    FontSize="21" ToolTip="{local:T 'Adicionar componente (A)'}"
                    Click="AdicionarPeca"/>

            <Button x:Name="btMenu" Style="{StaticResource Redondo}" Background="{DynamicResource Borda}"
                    Foreground="{DynamicResource TextoForte}"
                    Content="⋮" FontSize="19" ToolTip="{local:T 'Mais opções'}"
                    Click="AbrirMenu">
                <Button.ContextMenu>
                    <ContextMenu x:Name="menuOpcoes" Background="{DynamicResource Painel}"
                                 Foreground="{DynamicResource Texto}" BorderBrush="{DynamicResource Borda}">
                        <!-- Nada de submenu: em tema escuro o WPF abre o
                             popup do submenu com o fundo claro do sistema e
                             herda a cor de texto clara da janela, entao os
                             itens saiam claro sobre claro. Tudo plano, tudo
                             legivel, e salvar fica a um clique. -->
                        <!-- PROJETO -->
                        <MenuItem Header="{local:T 'Novo projeto'}" Uid="novo"
                                  Click="NovoCircuito"/>
                        <MenuItem Header="{local:T 'Abrir projeto...'}" Uid="abrir"
                                  Click="AbrirCircuito"/>
                        <MenuItem Header="{local:T 'Salvar projeto'}" Uid="salvar"
                                  Click="SalvarCircuito"/>
                        <MenuItem Header="{local:T 'Salvar projeto como...'}" Uid="salvar-como"
                                  Click="SalvarComo"/>
                        <MenuItem x:Name="miRecentes" Header="{local:T 'Projetos recentes'}"/>
                        <MenuItem x:Name="miDemos" Header="{local:T 'Exemplos prontos'}"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- CODIGO DA PLACA -->
                        <MenuItem Header="{local:T 'Enviar código para a placa (.ino)...'}"
                                  Click="EnviarInoParaPlaca"/>
                        <MenuItem Header="{local:T 'Baixar código da placa (.ino)...'}"
                                  Click="BaixarInoDaPlaca"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- CIRCUITO EM JSON -->
                        <MenuItem Header="{local:T 'Importar circuito (diagram.json)...'}"
                                  Uid="importar" Click="ImportarDoWokwi"/>
                        <MenuItem Header="{local:T 'Importar base de SVG (frame)...'}"
                                  ToolTip="{local:T 'O desenho de corte da placa do seu robô: o contorno e os furos viram uma base onde as peças ficam'}"
                                  Click="ImportarBaseSvg"/>
                        <MenuItem x:Name="miExportar" Header="{local:T 'Exportar circuito (diagram.json)...'}"
                                  Click="ExportarParaWokwi"/>
                        <MenuItem x:Name="miExportarHex"
                                  Header="{local:T 'Exportar programa gravável (.hex)...'}"
                                  ToolTip="{local:T 'Só para Assembly: o mesmo binário que rodou aqui'}"
                                  Click="ExportarHex"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- EDITAR -->
                        <MenuItem Header="{local:T 'Desfazer'}" Uid="desfazer" Click="Desfazer"/>
                        <MenuItem Header="{local:T 'Refazer'}" Uid="refazer" Click="Refazer"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- VISUALIZAR -->
                        <MenuItem Header="{local:T 'Ajustar à tela'}" Uid="ajustar" Click="Ajustar"/>
                        <MenuItem Header="{local:T 'Mostrar a grade'}" Uid="grade"
                                  Click="AlternarGrade"/>
                        <MenuItem Header="{local:T 'Tela cheia'}" Uid="tela-cheia"
                                  Click="TelaCheia"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- FIOS -->
                        <MenuItem x:Name="miFioSolto" Header="{local:T 'Fios: solto (curva)'}"
                                  IsCheckable="True" IsChecked="True"
                                  Tag="solto" Click="EstiloDeTodosOsFios"/>
                        <MenuItem x:Name="miFioReto" Header="{local:T 'Fios: reto (linha direta)'}"
                                  IsCheckable="True"
                                  Tag="reto" Click="EstiloDeTodosOsFios"/>
                        <MenuItem x:Name="miFioDegrau" Header="{local:T 'Fios: degrau (em L)'}"
                                  IsCheckable="True"
                                  Tag="degrau" Click="EstiloDeTodosOsFios"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- CONEXOES: o celular do Bluetooth e o broker MQTT do computador -->
                        <MenuItem Header="{local:T 'Bluetooth (celular)...'}" Uid="celular" Click="AbrirCelular"/>
                        <MenuItem Header="{local:T 'MQTT (broker do computador)...'}" Uid="mqtt" Click="AbrirMqtt"/>
                        <MenuItem x:Name="miInternet" Header="{local:T 'Usar a internet do computador'}"
                                  IsCheckable="True" IsChecked="True" Click="AlternarInternet"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- PROGRAMA -->
                        <MenuItem Header="{local:T 'Novo chip...'}" Click="NovoChip"/>
                        <MenuItem Header="{local:T 'Gerenciador de bibliotecas...'}" Uid="bibliotecas" Click="AbrirBibliotecas"/>
                        <MenuItem Header="{local:T 'Configurações...'}" Uid="configuracoes" Click="AbrirConfiguracoes"/>
                        <MenuItem Header="{local:T 'Atalhos do teclado...'}" Uid="atalhos" Click="AbrirAtalhos"/>
                        <MenuItem Header="{local:T 'Ajuda e atalhos'}" Uid="ajuda" Click="Ajuda"/>
                        <MenuItem Header="{local:T 'Buscar atualizações...'}" Uid="atualizacoes" Click="BuscarAtualizacoes"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border Width="1" Background="{DynamicResource Borda}" Margin="4,6,14,6"/>

            <Button x:Name="btModoSimulacao" Content="{local:T 'SIMULAÇÃO'}" Tag="simulacao"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoCircuito" Content="{local:T 'MULTÍMETRO'}" Tag="circuito"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoComponentes" Content="{local:T 'COMPONENTES'}" Tag="componentes"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoDescricao" Content="{local:T 'DESCRIÇÃO'}" Tag="descricao"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>

            <TextBlock x:Name="txtDica" VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{DynamicResource TextoFraco}" FontSize="11"/>

            <!-- O mesmo aviso do txtStatus, mas aqui em cima.
                 So aparece quando a coluna da direita fecha por estar
                 vazia: sem isto, soltar o codigo E o monitor serial
                 faria o erro de compilacao sumir junto com a coluna. -->
            <TextBlock x:Name="txtStatusNaBarra" VerticalAlignment="Center"
                       Margin="20,0,0,0" FontSize="11" Visibility="Collapsed"/>
        </StackPanel>
        </DockPanel>

        <!-- ================= EDITOR ================= -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Border CornerRadius="6" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <local:EditorCircuito x:Name="editor" FlowDirection="LeftToRight"/>
            </Border>

            <!-- O multimetro: so na aba MULTÍMETRO, no canto de cima da direita. -->
            <local:PainelMultimetro x:Name="painelMultimetro" Visibility="Collapsed"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>

            <!-- Tab do objeto selecionado: aparece sobre o canvas. Vem ANTES
                 das paginas de Componentes e Descricao: elas sao opacas e
                 ficam por cima, e a barra do objeto nao cobre mais o
                 comeco delas. -->
            <Border x:Name="barraObjeto" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MinWidth="230" MaxWidth="340"
                    Margin="12" Padding="8,6" CornerRadius="6"
                    Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14"
                                      ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <!-- Em pe: o nome e as ferramentas em cima, e as opcoes uma
                     embaixo da outra (Nome, X, Y, depois as da peca). Deitada,
                     a peca com muita opcao passava da largura da tela. -->
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                            <Button x:Name="btGirar" Content="&#x21BB;" Click="Girar"
                                    ToolTip="{local:T 'Girar 90° (R)'}" Style="{StaticResource FerramentaObj}"/>
                            <Button x:Name="btEspelhar" Content="&#x21C6;" Click="Espelhar"
                                    ToolTip="{local:T 'Espelhar (M)'}" Style="{StaticResource FerramentaObj}"/>
                            <Button x:Name="btApagar" Content="&#x1F5D1;" Click="Excluir"
                                    ToolTip="{local:T 'Excluir (Del)'}" Style="{StaticResource FerramentaObj}"/>
                            <Button Content="?" Click="Ajuda" ToolTip="{local:T 'Ajuda'}"
                                    Style="{StaticResource FerramentaObj}"/>
                            <Button Content="&#x2715;" Click="LimparSelecao" ToolTip="{local:T 'Fechar'}"
                                    Style="{StaticResource FerramentaObj}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtObjeto" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoForte}" FontWeight="SemiBold" FontSize="12"
                                   Margin="4,0,0,0"/>
                    </DockPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Borda}" Margin="0,6,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,0,4,2">
                        <local:ColunaDeOpcoes x:Name="opcoesObjeto"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- DESCRICAO: o nome, o autor e o texto do projeto, em cartoes
                 como os das Configuracoes. O nome e o autor sao os mesmos da
                 barra de cima e do "name"/"author" do diagram.json. -->
            <Border x:Name="painelDescricao" Visibility="Collapsed"
                    CornerRadius="6" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Background="{DynamicResource Fundo}" Padding="20,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{local:T 'Descrição do projeto'}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextoForte}"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextoFraco}"
                                   Text="{local:T 'O que este circuito faz, como ligar, o que falta. Vai junto no .sktch.'}"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource Cartao}" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{local:T 'NOME DO CIRCUITO'}" Style="{StaticResource Titulo}"/>
                                <Grid>
                                    <TextBox x:Name="txtNomeNaDescricao" Padding="8,5" FontSize="13"
                                             TextChanged="MudouNomeOuAutor"/>
                                    <TextBlock x:Name="dicaNomeNaDescricao" IsHitTestVisible="False" Margin="11,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextoFraco}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:T 'AUTOR'}" Style="{StaticResource Titulo}"/>
                                <Grid>
                                    <TextBox x:Name="txtAutorNaDescricao" Padding="8,5" FontSize="13"
                                             TextChanged="MudouNomeOuAutor"/>
                                    <TextBlock x:Name="dicaAutorNaDescricao" IsHitTestVisible="False" Margin="11,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextoFraco}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Cartao}" Padding="14,12" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{local:T 'DESCRIÇÃO'}" Style="{StaticResource Titulo}"/>
                            <TextBox x:Name="txtDescricao" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="10,8" FontSize="13" VerticalContentAlignment="Top"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- COMPONENTES: o circuito em cartoes: a placa com o que esta
                 ligado nela, cada protoboard com o que esta espetado e o que
                 ficou solto. Quem desenha os cartoes e o PainelDeComponentes. -->
            <Border x:Name="painelComponentes" Visibility="Collapsed"
                    CornerRadius="6" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Background="{DynamicResource Fundo}" Padding="20,16,20,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="&#x2197;" VerticalAlignment="Top"
                                Click="SoltarComponentes"
                                ToolTip="{local:T 'Abrir a lista numa janela separada'}"
                                Style="{StaticResource BotaoPequeno}"
                                Padding="7,1" Margin="10,0,0,0"/>
                        <StackPanel x:Name="resumoComponentes" DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="{local:T 'Componentes'}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextoForte}"/>
                            <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextoFraco}"
                                       Text="{local:T 'Tudo o que está no circuito. Clicar seleciona a peça no desenho; a seta abre e fecha.'}"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="listaDeComponentes" Margin="0,0,4,10"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter x:Name="divisoriaDasColunas" Grid.Row="1" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ================= CODIGO ================= -->
        <Grid x:Name="colunaDoCodigo" Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- A divisoria: ate a Alpha 16 esta altura era fixa em
                     232 px, e num monitor pequeno o monitor serial
                     comia o editor. Agora a pessoa decide. -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="232" MinHeight="90"/>
            </Grid.RowDefinitions>

            <Border x:Name="painelDoCodigo" Grid.Row="0" Background="{DynamicResource Painel}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <!-- De quem e este codigo. Com duas placas no circuito,
                         sem isto nao da para saber qual esta no campo. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Campo}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="10,6">
                        <!-- Ordem de proposito: quem e docado primeiro
                             ganha o espaco primeiro, e o ULTIMO fica com a
                             sobra. A linguagem vinha por ultimo, e com duas
                             placas o aviso comprido a cortava ("o (C++)").
                             Agora quem encolhe e o nome da placa, com
                             reticencias. -->
                        <DockPanel>
                            <!-- A linguagem que o simulador entendeu. Fica
                                 a vista porque quem escolhe e o CODIGO: sem
                                 o aviso, um sketch em Python que o detector
                                 leu como C++ so daria erro ao rodar. -->
                            <TextBlock x:Name="rotuloLinguagem" FlowDirection="LeftToRight" DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextoFraco}"
                                       ToolTip="{local:T 'A linguagem sai do proprio codigo do sketch'}"
                                       FontSize="11" Text="Arduino (C++)"/>
                            <TextBlock x:Name="txtOutrasPlacas" DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextoFraco}"
                                       FontSize="11"/>
                            <TextBlock x:Name="txtPlacaDoCodigo" Text="ESP32 DevKit V1"
                                       Foreground="{DynamicResource Texto}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Painel}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1"
                            Padding="10,3,6,3">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#x2197;"
                                    Click="SoltarPainelDoCodigo"
                                    ToolTip="{local:T 'Abrir o código numa janela separada'}"
                                    Style="{StaticResource BotaoPequeno}"
                                    Padding="7,1" Margin="6,0,0,0"/>
                            <Button x:Name="btMenuArquivos" DockPanel.Dock="Right"
                                    Content="&#x25BE;" Click="MenuDeArquivos"
                                    ToolTip="{local:T 'Novo arquivo, renomear, carregar, apagar'}"
                                    Style="{StaticResource BotaoPequeno}"
                                    Padding="8,1" Margin="6,0,0,0"/>
                            <Border DockPanel.Dock="Right" Width="1" Margin="4,3"
                                    Background="{DynamicResource Borda}"/>
                            <ScrollViewer x:Name="rolagemDasAbas"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="RolarAbasDeArquivo">
                                <StackPanel x:Name="abasDeArquivo" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- AvalonEdit no lugar do TextBox: um TextBox nao tem
                         como pintar so uma palavra. Traz numero de linha
                         de brinde, que ajuda quando o erro diz "linha 23". -->
                    <avalon:TextEditor x:Name="txtCodigo" FlowDirection="LeftToRight"
                                       Background="Transparent"
                                       Foreground="{DynamicResource Texto}"
                                       BorderThickness="0" Padding="6"
                                       FontFamily="Consolas" FontSize="12"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <TextBlock x:Name="txtStatus" Grid.Row="1" Margin="2,8"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"/>

            <!-- Aparece so com o sketch pausado. Em cima do monitor serial, e
                 nao numa janela a parte: o que se compara e o valor da
                 variavel com o que o circuito esta mostrando. -->
            <Border x:Name="painelVariaveis" Grid.Row="2" Visibility="Collapsed"
                    Background="{DynamicResource Painel}" BorderBrush="{DynamicResource BordaDoAviso}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock x:Name="txtTituloVariaveis" DockPanel.Dock="Top"
                               Text="{local:T 'PAUSADO'}" Style="{StaticResource Titulo}"
                               Foreground="{DynamicResource Aviso}"/>
                    <ScrollViewer x:Name="rolagemVariaveis" MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtVariaveis" FlowDirection="LeftToRight" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="NoWrap" LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="divisoriaDoCodigo"
                          Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="Transparent"
                          ShowsPreview="True" Cursor="SizeNS"
                          ToolTip="{local:T 'Arraste para dividir o espaço entre o código e este painel'}"/>

            <Border x:Name="painelDeBaixo" Grid.Row="4"
                    Background="{DynamicResource Campo}" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <!-- Tres assuntos no mesmo canto da tela: o que o sketch
                         imprime, o que a rede fez e o Bluetooth. E o canto
                         para onde a pessoa ja olha quando roda o programa. -->
                    <!-- Cada aba com a seta dela: o pedido da Alpha 18 e
                         poder ter "o bluetooth acoplado e o serial fora",
                         e para isso a seta tem que ser por aba, e nao
                         uma so para o painel inteiro. A ultima, depois
                         da divisoria, continua soltando as tres juntas. -->
                    <!-- A fileira das abas e o botao de soltar tudo dividem a
                         mesma linha, mas o botao fica PRESO na direita. Na
                         Alpha 18 ele vinha no fim da fileira e, na largura
                         normal da coluna, ficava cortado fora da borda. -->
                    <!-- Uma fileira so, com as abas em pilula como as de cima
                         (SIMULACAO, MULTIMETRO...). Ate a Alpha 24 cada aba tinha
                         a seta dela e a fileira quebrava em duas linhas; agora a
                         seta e uma so, na direita, e solta a aba que esta aberta
                         (o "bluetooth acoplado e o serial fora" da Alpha 18
                         continua: abre o serial, solta, volta ao bluetooth).
                         Coluna estreita demais: a fileira rola de lado (roda do
                         mouse), e nao quebra. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="&#x29C9;" Click="SoltarPainelDeBaixo"
                            ToolTip="{local:T 'Abrir todas numa janela separada só'}"
                            Style="{StaticResource BotaoPequeno}"
                            Padding="7,1" Margin="4,0,0,0"/>
                    <Button x:Name="btSoltarAbaAberta" DockPanel.Dock="Right" Content="&#x2197;"
                            Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                            Padding="7,1" Margin="6,0,0,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="RolarAbasDeArquivo">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaConsole" Content="{local:T 'CONSOLE'}" Tag="console"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btAbaSerial" Content="{local:T 'MONITOR SERIAL'}" Tag="serial"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btAbaRede" Content="{local:T 'REDE'}" Tag="rede"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btAbaBluetooth" Content="{local:T 'BLUETOOTH'}" Tag="bluetooth"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btAbaPlaca" Content="{local:T 'PLACA'}" Tag="placa"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>

                    <!-- As quatro abas numa grade so, uma por cima da outra.
                         Soltas no DockPanel, elas ficavam presas a ESQUERDA
                         com a largura do proprio conteudo, e o campo de
                         digitar do monitor serial saia com doze pixels. -->
                    <Grid x:Name="gradeDasAbas">
                    <!-- console: o que o SIMULADOR tem a dizer.
                         O monitor serial ao lado e do SKETCH: cada linha
                         de la saiu de um Serial.println. Aqui sai o que
                         compilou, o que queimou e o que parou, que ate a
                         Alpha 17 cabia numa linha de status so e se
                         perdia na mensagem seguinte. -->
                    <DockPanel x:Name="abaConsole" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{local:T 'Copiar'}" Width="64"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="CopiarConsole"
                                    ToolTip="{local:T 'Copiar o console inteiro'}"/>
                            <Button DockPanel.Dock="Right" Content="{local:T 'Limpar'}" Width="64"
                                    Style="{StaticResource BotaoPequeno}"
                                    Click="LimparConsole"/>
                            <TextBlock Text="{local:T 'o que o simulador fez — o que o sketch imprime fica no monitor serial'}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextoFraco}"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemConsole" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="txtConsole" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="15"
                                       LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- monitor serial -->
                    <DockPanel x:Name="abaSerial">
                        <!-- O que se digita aqui chega no Serial.read() do
                             sketch: ate a 1.4 nao havia como mandar nada. -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <!-- O baud do monitor, como o da IDE: diferente do Serial.begin,
                                 o texto sai embaralhado nos dois sentidos. -->
                            <Button DockPanel.Dock="Right" x:Name="btBaudSerial" Content="{local:T '9600 baud'}" Width="92"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="AbrirListaDeBaud"
                                    ToolTip="{local:T 'O baud do monitor serial da placa do editor (o do Serial.begin do sketch)'}"/>
                            <Button DockPanel.Dock="Right" Content="{local:T 'Enviar'}" MinWidth="64" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="EnviarPeloSerial"/>
                            <TextBox x:Name="txtEntradaSerial" FlowDirection="LeftToRight" Style="{StaticResource CampoEscuro}"
                                     ToolTip="{local:T 'Texto para o sketch (Serial.available / Serial.read)'}"
                                     KeyDown="TeclaNaEntradaSerial"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemSerial" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto" ScrollChanged="RolouOSerial">
                            <!-- Sem quebra automatica: cada println e uma linha, e
                                 linha comprida rola de lado em vez de virar duas. -->
                            <TextBlock x:Name="txtSerial" FlowDirection="LeftToRight" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Terminal}" TextWrapping="NoWrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- rede -->
                    <DockPanel x:Name="abaRede" Visibility="Collapsed">
                        <!-- Publicar no MQTT, como o app de celular da aula. -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="{local:T 'Publicar'}" Width="70" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="PublicarNoMqtt"/>
                            <TextBox x:Name="txtTopicoMqtt" Width="160" Margin="0,0,6,0"
                                     Style="{StaticResource CampoEscuro}" Text="aula/teste"
                                     ToolTip="{local:T 'Topico MQTT'}"/>
                            <TextBox x:Name="txtMensagemMqtt" Style="{StaticResource CampoEscuro}"
                                     ToolTip="{local:T 'Mensagem'}" KeyDown="TeclaNoMqtt"/>
                        </DockPanel>
                        <!-- O aviso de que o radio do computador nao pode ser
                             usado. Fica AQUI, e nao no monitor serial: o
                             monitor e do sketch, e o aluno tem que saber que
                             o simulador trocou o WiFi de verdade pelo
                             inventado sem que o programa dele mude. -->
                        <Border x:Name="avisoDeRadio" DockPanel.Dock="Top" Visibility="Collapsed"
                                Margin="0,0,0,6" Padding="9,6" CornerRadius="4"
                                Background="{DynamicResource Painel}"
                                BorderThickness="1" BorderBrush="{DynamicResource BordaDoAviso}">
                            <TextBlock x:Name="txtAvisoDeRadio" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
                        </Border>
                        <WrapPanel x:Name="linksDeRede" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                        <ScrollViewer x:Name="rolagemRede" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtRede" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TerminalRede}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- bluetooth -->
                    <DockPanel x:Name="abaBluetooth" Visibility="Collapsed">
                        <!-- O celular da aula: acha a placa, conecta e conversa. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" x:Name="btAbrirCelular" Content="{local:T 'Abrir o celular'}"
                                    Width="120" Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="AbrirCelular"
                                    ToolTip="{local:T 'O celular simulado (1280x720): procura as placas, conversa pelo Bluetooth clássico e navega no BLE'}"/>
                            <Button DockPanel.Dock="Right" x:Name="btConectarBt" Content="{local:T 'Conectar'}"
                                    Width="96" Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="ConectarOuSairDoBluetooth"/>
                            <Button DockPanel.Dock="Left" x:Name="btDispositivosBt" Width="150"
                                    Content="{local:T 'Escolher a placa'}" Style="{StaticResource BotaoPequeno}"
                                    Click="AbrirListaDeBluetooth"
                                    ToolTip="{local:T 'Placas com SerialBT.begin() chamado'}"/>
                            <TextBlock x:Name="txtBtEscolhido" Margin="10,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"
                                       Text="{local:T 'nenhuma placa com Bluetooth ligado'}"/>
                        </DockPanel>
                        <Border x:Name="avisoDeBluetooth" DockPanel.Dock="Top" Visibility="Collapsed"
                                Margin="0,0,0,6" Padding="9,6" CornerRadius="4"
                                Background="{DynamicResource Painel}"
                                BorderThickness="1" BorderBrush="{DynamicResource BordaDoAviso}">
                            <TextBlock x:Name="txtAvisoDeBluetooth" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
                        </Border>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="{local:T 'Enviar'}" MinWidth="64" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="EnviarPeloBluetooth"/>
                            <TextBox x:Name="txtEntradaBt" Style="{StaticResource CampoEscuro}"
                                     ToolTip="{local:T 'Texto para a placa conectada'}" KeyDown="TeclaNoBluetooth"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemBt" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtBluetooth" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TerminalBt}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- placa de verdade: o compilador do Arduino e a USB -->
                    <DockPanel x:Name="abaPlaca" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" x:Name="btMandarNaAba" Content="{local:T 'Mandar para a placa'}"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="MandarParaPlaca"/>
                            <Button DockPanel.Dock="Right" x:Name="btVerificarNaAba" Content="{local:T 'Verificar'}"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="Verificar"/>
                            <Button DockPanel.Dock="Right" x:Name="btMonitorPlaca" Content="{local:T 'Monitor serial'}"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="AlternarMonitorDaPlaca"
                                    ToolTip="{local:T 'O monitor serial da placa de verdade, na porta escolhida'}"/>
                            <Button DockPanel.Dock="Left" x:Name="btPortaPlaca" Width="150"
                                    Content="{local:T 'Escolher a porta'}" Style="{StaticResource BotaoPequeno}"
                                    Click="AbrirMenuDasPortas"
                                    ToolTip="{local:T 'As placas ligadas na USB deste computador'}"/>
                            <TextBlock x:Name="txtPortaEscolhida" Margin="10,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"
                                       TextTrimming="CharacterEllipsis" Text="{local:T 'nenhuma porta'}"/>
                        </DockPanel>
                        <TextBlock x:Name="txtPlacaEstado" DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"/>
                        <!-- O que se manda para a placa de verdade, com o monitor dela aberto. -->
                        <DockPanel x:Name="painelEntradaPlaca" DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Content="{local:T 'Enviar'}" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="EnviarParaAPlaca"/>
                            <TextBox x:Name="txtEntradaPlaca" Style="{StaticResource CampoEscuro}" KeyDown="TeclaNaEntradaPlaca"
                                     ToolTip="{local:T 'Texto para a placa de verdade (vai com o fim de linha do monitor do simulador)'}"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemPlaca" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtPlaca" FlowDirection="LeftToRight" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Texto}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
