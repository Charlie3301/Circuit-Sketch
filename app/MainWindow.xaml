<Window x:Class="Simulador.App.MainWindow"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Simulador.App"
        Title="CircuitSketch"
        Icon="assets/CircuitSketch.ico"
        Height="800" Width="1400"
        MinHeight="560" MinWidth="900"
        Background="{DynamicResource Fundo}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Aba do painel de baixo: parece titulo, e acende na escolhida. -->
        <Style x:Key="Modo" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="12,0">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Aba" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoFraco}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <!-- TextBlock explicito, e nao ContentPresenter: o
                                 estilo implicito de TextBlock do app pinta o
                                 texto gerado por ele e a aba escolhida nunca
                                 acendia. -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BotaoPequeno, CampoEscuro e BotaoDaAbertura ficam em
             App.xaml: a janela de configuracoes, a de teclas e a de
             abertura tambem precisam deles, e estilo declarado numa
             janela so vale naquela janela. -->

        <Style x:Key="Redondo" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Background" Value="{DynamicResource Borda}"/>
                                <Setter Property="Foreground" Value="#777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botao de texto da tab do objeto. Sem isto ele cai no estilo
             padrao do WPF, que tem fundo claro; como a janela e escura e
             manda uma Foreground clara por heranca, sobrava texto claro
             em fundo claro e nao dava para ler o rotulo. -->
        <Style x:Key="AcaoObj" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextoForte}"/>
            <Setter Property="Background" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FerramentaObj" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoForte}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="f" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="f" Property="Background" Value="{DynamicResource Borda}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="gradeRaiz" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="420" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= BARRA ================= -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="True">

            <!-- Verificar e Mandar para a placa, no canto direito, com os
                 simbolos da Arduino IDE: o visto e a seta. Mandar e para a
                 placa DE VERDADE, pela USB; o Rodar da esquerda e o
                 simulador. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btVerificar" Style="{StaticResource Redondo}" Background="#00878F"
                        Content="&#x2713;" FontSize="17" Click="Verificar"
                        ToolTip="Verificar o código: o simulador e o compilador do Arduino (Ctrl+R)"/>
                <Button x:Name="btMandar" Style="{StaticResource Redondo}" Background="#00878F"
                        Content="&#x279C;" FontSize="16" Click="MandarParaPlaca"
                        ToolTip="Mandar para a placa de verdade, pela USB (Ctrl+U)"/>
            </StackPanel>

        <StackPanel Orientation="Horizontal">

            <Button x:Name="btRodar" Style="{StaticResource Redondo}"
                    Background="#2FA84F" Content="▶" ToolTip="Rodar a simulação (F5)"
                    Click="Rodar"/>
            <Button x:Name="btParar" Style="{StaticResource Redondo}"
                    Background="#C0392B" Content="■" ToolTip="Parar (F5)"
                    Click="Parar" IsEnabled="False"/>
            <!-- Depurador. Ficam ao lado do rodar/parar porque sao o mesmo
                 assunto: o que o sketch esta fazendo agora. -->
            <Button x:Name="btPausar" Style="{StaticResource Redondo}" Background="#D68910"
                    Content="❚❚" FontSize="12" ToolTip="Pausar (F6)" Click="PausarOuContinuar" IsEnabled="False"/>
            <Button x:Name="btPasso" Style="{StaticResource Redondo}" Background="#7D3C98"
                    Content="▶❚" FontSize="12" ToolTip="Andar uma linha (F10)" Click="Passo" IsEnabled="False"/>
            <Button Style="{StaticResource Redondo}" Background="#1668C1" Content="+"
                    FontSize="21" ToolTip="Adicionar componente (A)"
                    Click="AdicionarPeca"/>

            <Button x:Name="btMenu" Style="{StaticResource Redondo}" Background="{DynamicResource Borda}"
                    Foreground="{DynamicResource TextoForte}"
                    Content="⋮" FontSize="19" ToolTip="Mais opções"
                    Click="AbrirMenu">
                <Button.ContextMenu>
                    <ContextMenu x:Name="menuOpcoes" Background="{DynamicResource Painel}"
                                 Foreground="{DynamicResource Texto}" BorderBrush="{DynamicResource Borda}">
                        <!-- Nada de submenu: em tema escuro o WPF abre o
                             popup do submenu com o fundo claro do sistema e
                             herda a cor de texto clara da janela, entao os
                             itens saiam claro sobre claro. Tudo plano, tudo
                             legivel, e salvar fica a um clique. -->
                        <!-- PROJETO -->
                        <MenuItem Header="Novo projeto" InputGestureText="Ctrl+N"
                                  Click="NovoCircuito"/>
                        <MenuItem Header="Abrir projeto..." InputGestureText="Ctrl+O"
                                  Click="AbrirCircuito"/>
                        <MenuItem Header="Salvar projeto" InputGestureText="Ctrl+S"
                                  Click="SalvarCircuito"/>
                        <MenuItem Header="Salvar projeto como..." InputGestureText="Ctrl+Shift+S"
                                  Click="SalvarComo"/>
                        <MenuItem x:Name="miRecentes" Header="Projetos recentes"/>
                        <MenuItem x:Name="miDemos" Header="Exemplos prontos"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- CODIGO DA PLACA -->
                        <MenuItem Header="Enviar código para a placa (.ino)..."
                                  Click="EnviarInoParaPlaca"/>
                        <MenuItem Header="Baixar código da placa (.ino)..."
                                  Click="BaixarInoDaPlaca"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- CIRCUITO EM JSON -->
                        <MenuItem Header="Importar circuito (diagram.json)..."
                                  InputGestureText="Ctrl+I" Click="ImportarDoWokwi"/>
                        <MenuItem Header="Exportar circuito (diagram.json)..."
                                  Click="ExportarParaWokwi"/>
                        <MenuItem x:Name="miExportarHex"
                                  Header="Exportar programa gravável (.hex)..."
                                  ToolTip="Só para Assembly: o mesmo binário que rodou aqui"
                                  Click="ExportarHex"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- EDITAR -->
                        <MenuItem Header="Desfazer" InputGestureText="Ctrl+Z" Click="Desfazer"/>
                        <MenuItem Header="Refazer" InputGestureText="Ctrl+Y" Click="Refazer"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- VISUALIZAR -->
                        <MenuItem Header="Ajustar à tela" InputGestureText="F" Click="Ajustar"/>
                        <MenuItem Header="Mostrar a grade" InputGestureText="G"
                                  Click="AlternarGrade"/>
                        <MenuItem Header="Tela cheia" InputGestureText="Alt+Enter"
                                  Click="TelaCheia"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- FIOS -->
                        <MenuItem x:Name="miFioSolto" Header="Fios: solto (curva)"
                                  IsCheckable="True" IsChecked="True"
                                  Tag="solto" Click="EstiloDeTodosOsFios"/>
                        <MenuItem x:Name="miFioReto" Header="Fios: reto (linha direta)"
                                  IsCheckable="True"
                                  Tag="reto" Click="EstiloDeTodosOsFios"/>
                        <MenuItem x:Name="miFioDegrau" Header="Fios: degrau (em L)"
                                  IsCheckable="True"
                                  Tag="degrau" Click="EstiloDeTodosOsFios"/>
                        <Separator Background="{DynamicResource Borda}"/>

                        <!-- PROGRAMA -->
                        <MenuItem x:Name="miInternet" Header="Usar a internet do computador"
                                  IsCheckable="True" IsChecked="True" Click="AlternarInternet"/>
                        <MenuItem Header="Novo chip..." Click="NovoChip"/>
                        <MenuItem Header="Bibliotecas..." Click="AbrirBibliotecas"/>
                        <MenuItem Header="Configurações..." Click="AbrirConfiguracoes"/>
                        <MenuItem Header="Ajuda e atalhos" InputGestureText="?" Click="Ajuda"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border Width="1" Background="{DynamicResource Borda}" Margin="4,6,14,6"/>

            <Button x:Name="btModoSimulacao" Content="SIMULAÇÃO" Tag="simulacao"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoCircuito" Content="VISÃO DE CIRCUITO" Tag="circuito"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoComponentes" Content="COMPONENTES" Tag="componentes"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>
            <Button x:Name="btModoDescricao" Content="DESCRIÇÃO" Tag="descricao"
                    Style="{StaticResource Modo}" Click="TrocarModo"/>

            <TextBlock x:Name="txtDica" VerticalAlignment="Center" Margin="20,0,0,0"
                       Foreground="{DynamicResource TextoFraco}" FontSize="11"/>

            <!-- O mesmo aviso do txtStatus, mas aqui em cima.
                 So aparece quando a coluna da direita fecha por estar
                 vazia: sem isto, soltar o codigo E o monitor serial
                 faria o erro de compilacao sumir junto com a coluna. -->
            <TextBlock x:Name="txtStatusNaBarra" VerticalAlignment="Center"
                       Margin="20,0,0,0" FontSize="11" Visibility="Collapsed"/>
        </StackPanel>
        </DockPanel>

        <!-- ================= EDITOR ================= -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Border CornerRadius="6" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <local:EditorCircuito x:Name="editor"/>
            </Border>

            <Border x:Name="painelDescricao" Visibility="Collapsed"
                    CornerRadius="6" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Background="{DynamicResource Campo}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource TextoFraco}"
                               Text="O que este circuito faz, como ligar, o que falta. Vai junto no .sktch."/>
                    <TextBox x:Name="txtDescricao" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource Campo}" Foreground="{DynamicResource Texto}"
                             CaretBrush="{DynamicResource Texto}" BorderBrush="{DynamicResource Borda}"
                             BorderThickness="1" Padding="10,8" FontSize="13"
                             VerticalContentAlignment="Top"/>
                </DockPanel>
            </Border>

            <Border x:Name="painelComponentes" Visibility="Collapsed"
                    CornerRadius="6" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" Background="{DynamicResource Campo}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="&#x2197;"
                                Click="SoltarComponentes"
                                ToolTip="Abrir a lista numa janela separada"
                                Style="{StaticResource BotaoPequeno}"
                                Padding="7,1" Margin="8,0,0,0"/>
                        <TextBlock x:Name="txtResumoComponentes" DockPanel.Dock="Right"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextoFraco}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextoFraco}"
                                   Text="Tudo o que está no circuito. A seta abre e fecha; clicar seleciona a peça no desenho."/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="listaDeComponentes"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tab do objeto selecionado: aparece sobre o canvas -->
            <Border x:Name="barraObjeto" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="12" Padding="8,6" CornerRadius="6"
                    Background="{DynamicResource Painel}" BorderBrush="{DynamicResource Borda}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14"
                                      ShadowDepth="3" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtObjeto" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextoForte}" FontWeight="SemiBold" FontSize="12"
                               Margin="4,0,10,0"/>
                    <StackPanel x:Name="opcoesObjeto" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                    <Border Width="1" Background="{DynamicResource Borda}" Margin="8,2,8,2"/>
                    <Button x:Name="btGirar" Content="&#x21BB;" Click="Girar"
                            ToolTip="Girar 90° (R)" Style="{StaticResource FerramentaObj}"/>
                    <Button x:Name="btEspelhar" Content="&#x21C6;" Click="Espelhar"
                            ToolTip="Espelhar (M)" Style="{StaticResource FerramentaObj}"/>
                    <Button x:Name="btApagar" Content="&#x1F5D1;" Click="Excluir"
                            ToolTip="Excluir (Del)" Style="{StaticResource FerramentaObj}"/>
                    <Button Content="?" Click="Ajuda" ToolTip="Ajuda"
                            Style="{StaticResource FerramentaObj}"/>
                    <Button Content="&#x2715;" Click="LimparSelecao" ToolTip="Fechar"
                            Style="{StaticResource FerramentaObj}"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter x:Name="divisoriaDasColunas" Grid.Row="1" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ================= CODIGO ================= -->
        <Grid x:Name="colunaDoCodigo" Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- A divisoria: ate a Alpha 16 esta altura era fixa em
                     232 px, e num monitor pequeno o monitor serial
                     comia o editor. Agora a pessoa decide. -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="232" MinHeight="90"/>
            </Grid.RowDefinitions>

            <Border x:Name="painelDoCodigo" Grid.Row="0" Background="{DynamicResource Painel}"
                    BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <!-- De quem e este codigo. Com duas placas no circuito,
                         sem isto nao da para saber qual esta no campo. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Campo}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="10,6">
                        <!-- Ordem de proposito: quem e docado primeiro
                             ganha o espaco primeiro, e o ULTIMO fica com a
                             sobra. A linguagem vinha por ultimo, e com duas
                             placas o aviso comprido a cortava ("o (C++)").
                             Agora quem encolhe e o nome da placa, com
                             reticencias. -->
                        <DockPanel>
                            <!-- A linguagem que o simulador entendeu. Fica
                                 a vista porque quem escolhe e o CODIGO: sem
                                 o aviso, um sketch em Python que o detector
                                 leu como C++ so daria erro ao rodar. -->
                            <TextBlock x:Name="rotuloLinguagem" DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextoFraco}"
                                       ToolTip="A linguagem sai do proprio codigo do sketch"
                                       FontSize="11" Text="Arduino (C++)"/>
                            <TextBlock x:Name="txtOutrasPlacas" DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextoFraco}"
                                       FontSize="11"/>
                            <TextBlock x:Name="txtPlacaDoCodigo" Text="ESP32 DevKit V1"
                                       Foreground="{DynamicResource Texto}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Painel}"
                            BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,0,1"
                            Padding="10,3,6,3">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#x2197;"
                                    Click="SoltarPainelDoCodigo"
                                    ToolTip="Abrir o código numa janela separada"
                                    Style="{StaticResource BotaoPequeno}"
                                    Padding="7,1" Margin="6,0,0,0"/>
                            <Button x:Name="btMenuArquivos" DockPanel.Dock="Right"
                                    Content="&#x25BE;" Click="MenuDeArquivos"
                                    ToolTip="Novo arquivo, renomear, carregar, apagar"
                                    Style="{StaticResource BotaoPequeno}"
                                    Padding="8,1" Margin="6,0,0,0"/>
                            <Border DockPanel.Dock="Right" Width="1" Margin="4,3"
                                    Background="{DynamicResource Borda}"/>
                            <ScrollViewer x:Name="rolagemDasAbas"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="RolarAbasDeArquivo">
                                <StackPanel x:Name="abasDeArquivo" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- AvalonEdit no lugar do TextBox: um TextBox nao tem
                         como pintar so uma palavra. Traz numero de linha
                         de brinde, que ajuda quando o erro diz "linha 23". -->
                    <avalon:TextEditor x:Name="txtCodigo"
                                       Background="Transparent"
                                       Foreground="{DynamicResource Texto}"
                                       BorderThickness="0" Padding="6"
                                       FontFamily="Consolas" FontSize="12"
                                       ShowLineNumbers="True"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>

            <TextBlock x:Name="txtStatus" Grid.Row="1" Margin="2,8"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"/>

            <!-- Aparece so com o sketch pausado. Em cima do monitor serial, e
                 nao numa janela a parte: o que se compara e o valor da
                 variavel com o que o circuito esta mostrando. -->
            <Border x:Name="painelVariaveis" Grid.Row="2" Visibility="Collapsed"
                    Background="{DynamicResource Painel}" BorderBrush="{DynamicResource BordaDoAviso}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock x:Name="txtTituloVariaveis" DockPanel.Dock="Top"
                               Text="PAUSADO" Style="{StaticResource Titulo}"
                               Foreground="{DynamicResource Aviso}"/>
                    <ScrollViewer x:Name="rolagemVariaveis" MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtVariaveis" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="NoWrap" LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="divisoriaDoCodigo"
                          Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="Transparent"
                          ShowsPreview="True" Cursor="SizeNS"
                          ToolTip="Arraste para dividir o espaço entre o código e este painel"/>

            <Border x:Name="painelDeBaixo" Grid.Row="4"
                    Background="{DynamicResource Campo}" BorderBrush="{DynamicResource Borda}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <!-- Tres assuntos no mesmo canto da tela: o que o sketch
                         imprime, o que a rede fez e o Bluetooth. E o canto
                         para onde a pessoa ja olha quando roda o programa. -->
                    <!-- Cada aba com a seta dela: o pedido da Alpha 18 e
                         poder ter "o bluetooth acoplado e o serial fora",
                         e para isso a seta tem que ser por aba, e nao
                         uma so para o painel inteiro. A ultima, depois
                         da divisoria, continua soltando as tres juntas. -->
                    <!-- A fileira das abas e o botao de soltar tudo dividem a
                         mesma linha, mas o botao fica PRESO na direita. Na
                         Alpha 18 ele vinha no fim da fileira e, na largura
                         normal da coluna, ficava cortado fora da borda. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="&#x29C9;" Click="SoltarPainelDeBaixo"
                            ToolTip="Abrir as quatro numa janela separada só"
                            Style="{StaticResource BotaoPequeno}"
                            Padding="7,1" Margin="6,0,0,0"/>
                    <!-- WrapPanel, e nao StackPanel: na largura padrao da coluna
                         as quatro abas com as setas nao cabem numa linha, e o
                         StackPanel cortava a ultima seta fora da borda. Aqui a
                         sobra desce para a linha de baixo e nada some. -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaConsole" Content="CONSOLE" Tag="console"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btSoltarConsole" Content="&#x2197;" Tag="console"
                                    Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                                    Padding="4,1" Margin="1,0,6,2"
                                    ToolTip="Abrir o console numa janela separada"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaSerial" Content="MONITOR SERIAL" Tag="serial"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btSoltarSerial" Content="&#x2197;" Tag="serial"
                                    Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                                    Padding="4,1" Margin="1,0,6,2"
                                    ToolTip="Abrir o monitor serial numa janela separada"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaRede" Content="REDE" Tag="rede"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btSoltarRede" Content="&#x2197;" Tag="rede"
                                    Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                                    Padding="4,1" Margin="1,0,6,2"
                                    ToolTip="Abrir a rede numa janela separada"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaBluetooth" Content="BLUETOOTH" Tag="bluetooth"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btSoltarBluetooth" Content="&#x2197;" Tag="bluetooth"
                                    Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                                    Padding="4,1" Margin="1,0,6,2"
                                    ToolTip="Abrir o Bluetooth numa janela separada"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btAbaPlaca" Content="PLACA" Tag="placa"
                                    Style="{StaticResource Aba}" Click="TrocarAba"/>
                            <Button x:Name="btSoltarPlaca" Content="&#x2197;" Tag="placa"
                                    Click="SoltarAbaDeBaixo" Style="{StaticResource BotaoPequeno}"
                                    Padding="4,1" Margin="1,0,4,2"
                                    ToolTip="Abrir a placa de verdade numa janela separada"/>
                        </StackPanel>
                    </WrapPanel>
                    </DockPanel>

                    <!-- As quatro abas numa grade so, uma por cima da outra.
                         Soltas no DockPanel, elas ficavam presas a ESQUERDA
                         com a largura do proprio conteudo, e o campo de
                         digitar do monitor serial saia com doze pixels. -->
                    <Grid x:Name="gradeDasAbas">
                    <!-- console: o que o SIMULADOR tem a dizer.
                         O monitor serial ao lado e do SKETCH: cada linha
                         de la saiu de um Serial.println. Aqui sai o que
                         compilou, o que queimou e o que parou, que ate a
                         Alpha 17 cabia numa linha de status so e se
                         perdia na mensagem seguinte. -->
                    <DockPanel x:Name="abaConsole" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Copiar" Width="64"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="CopiarConsole"
                                    ToolTip="Copiar o console inteiro"/>
                            <Button DockPanel.Dock="Right" Content="Limpar" Width="64"
                                    Style="{StaticResource BotaoPequeno}"
                                    Click="LimparConsole"/>
                            <TextBlock Text="o que o simulador fez — o que o sketch imprime fica no monitor serial"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextoFraco}"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemConsole" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="txtConsole" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="15"
                                       LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- monitor serial -->
                    <DockPanel x:Name="abaSerial">
                        <!-- O que se digita aqui chega no Serial.read() do
                             sketch: ate a 1.4 nao havia como mandar nada. -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Enviar" Width="64" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="EnviarPeloSerial"/>
                            <TextBox x:Name="txtEntradaSerial" Style="{StaticResource CampoEscuro}"
                                     ToolTip="Texto para o sketch (Serial.available / Serial.read)"
                                     KeyDown="TeclaNaEntradaSerial"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemSerial" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <!-- Sem quebra automatica: cada println e uma linha, e
                                 linha comprida rola de lado em vez de virar duas. -->
                            <TextBlock x:Name="txtSerial" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Terminal}" TextWrapping="NoWrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- rede -->
                    <DockPanel x:Name="abaRede" Visibility="Collapsed">
                        <!-- Publicar no MQTT, como o app de celular da aula. -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Publicar" Width="70" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="PublicarNoMqtt"/>
                            <TextBox x:Name="txtTopicoMqtt" Width="160" Margin="0,0,6,0"
                                     Style="{StaticResource CampoEscuro}" Text="aula/teste"
                                     ToolTip="Topico MQTT"/>
                            <TextBox x:Name="txtMensagemMqtt" Style="{StaticResource CampoEscuro}"
                                     ToolTip="Mensagem" KeyDown="TeclaNoMqtt"/>
                        </DockPanel>
                        <!-- O aviso de que o radio do computador nao pode ser
                             usado. Fica AQUI, e nao no monitor serial: o
                             monitor e do sketch, e o aluno tem que saber que
                             o simulador trocou o WiFi de verdade pelo
                             inventado sem que o programa dele mude. -->
                        <Border x:Name="avisoDeRadio" DockPanel.Dock="Top" Visibility="Collapsed"
                                Margin="0,0,0,6" Padding="9,6" CornerRadius="4"
                                Background="{DynamicResource Painel}"
                                BorderThickness="1" BorderBrush="{DynamicResource BordaDoAviso}">
                            <TextBlock x:Name="txtAvisoDeRadio" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
                        </Border>
                        <WrapPanel x:Name="linksDeRede" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                        <ScrollViewer x:Name="rolagemRede" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtRede" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TerminalRede}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- bluetooth -->
                    <DockPanel x:Name="abaBluetooth" Visibility="Collapsed">
                        <!-- O celular da aula: acha a placa, conecta e conversa. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" x:Name="btAbrirCelular" Content="Abrir o celular"
                                    Width="120" Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="AbrirCelular"
                                    ToolTip="O celular simulado (1280x720): procura as placas, conversa pelo Bluetooth clássico e navega no BLE"/>
                            <Button DockPanel.Dock="Right" x:Name="btConectarBt" Content="Conectar"
                                    Width="96" Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}"
                                    Click="ConectarOuSairDoBluetooth"/>
                            <Button DockPanel.Dock="Left" x:Name="btDispositivosBt" Width="150"
                                    Content="Escolher a placa" Style="{StaticResource BotaoPequeno}"
                                    Click="AbrirListaDeBluetooth"
                                    ToolTip="Placas com SerialBT.begin() chamado"/>
                            <TextBlock x:Name="txtBtEscolhido" Margin="10,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"
                                       Text="nenhuma placa com Bluetooth ligado"/>
                        </DockPanel>
                        <Border x:Name="avisoDeBluetooth" DockPanel.Dock="Top" Visibility="Collapsed"
                                Margin="0,0,0,6" Padding="9,6" CornerRadius="4"
                                Background="{DynamicResource Painel}"
                                BorderThickness="1" BorderBrush="{DynamicResource BordaDoAviso}">
                            <TextBlock x:Name="txtAvisoDeBluetooth" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
                        </Border>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Enviar" Width="64" Margin="6,0,0,0"
                                    Style="{StaticResource BotaoPequeno}" Click="EnviarPeloBluetooth"/>
                            <TextBox x:Name="txtEntradaBt" Style="{StaticResource CampoEscuro}"
                                     ToolTip="Texto para a placa conectada" KeyDown="TeclaNoBluetooth"/>
                        </DockPanel>
                        <ScrollViewer x:Name="rolagemBt" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtBluetooth" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TerminalBt}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- placa de verdade: o compilador do Arduino e a USB -->
                    <DockPanel x:Name="abaPlaca" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" x:Name="btMandarNaAba" Content="Mandar para a placa"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="MandarParaPlaca"/>
                            <Button DockPanel.Dock="Right" x:Name="btVerificarNaAba" Content="Verificar"
                                    Margin="6,0,0,0" Style="{StaticResource BotaoPequeno}" Click="Verificar"/>
                            <Button DockPanel.Dock="Left" x:Name="btPortaPlaca" Width="150"
                                    Content="Escolher a porta" Style="{StaticResource BotaoPequeno}"
                                    Click="EscolherPortaDaPlaca"
                                    ToolTip="As placas ligadas na USB deste computador"/>
                            <TextBlock x:Name="txtPortaEscolhida" Margin="10,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextoFraco}"
                                       TextTrimming="CharacterEllipsis" Text="nenhuma porta"/>
                        </DockPanel>
                        <TextBlock x:Name="txtPlacaEstado" DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextoFraco}"/>
                        <ScrollViewer x:Name="rolagemPlaca" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtPlaca" VerticalAlignment="Top" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Texto}" TextWrapping="Wrap"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
