<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- O simulador e um interpretador: sem otimizacao do JIT (o padrao da
         compilacao de depuracao) o executor do AVR nao dava os 16 MHz do chip.
         Otimizado sempre, inclusive na que roda os testes. -->
    <Optimize>true</Optimize>
    <RootNamespace>Simulador</RootNamespace>
    <AssemblyName>motor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- O modo nativo desvia uma tarefa do C que falhou (ou travou) de volta
         para o comeco dela, pelo contexto da thread. Com a pilha-sombra do
         processador (CET) ligada, o Windows recusa esse desvio e fecha o
         programa: o executavel sai sem a marca de compativel com CET. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <!-- O runtime do modo nativo (TinyCC, cabecalhos e o C do simulador) vai ao lado do executavel. -->
  <ItemGroup>
    <Content Include="..\nativo\**\*" Exclude="..\nativo\zig\**" LinkBase="nativo" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- O C# compilado de verdade (Alpha 26, fase 4): o compilador do proprio .NET. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- As bibliotecas do .NET para compilar contra (no executavel unico elas nao ficam no disco). -->
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" />
  </ItemGroup>
  <!-- A API das placas para o C# (nanoFramework, .NET IoT e a do Arduino): fonte
       compilada pelo Roslyn na hora, junto do programa (ver CompiladorCSharp). -->
  <ItemGroup>
    <Compile Remove="DotNet\Api\**" />
    <EmbeddedResource Include="DotNet\Api\*.cs" LogicalName="api/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Os catalogos de idiomas (Alpha 25): "idiomas/<codigo>.json", lidos pelo Idioma.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="idiomas\*.json" LogicalName="idiomas/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
