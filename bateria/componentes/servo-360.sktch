{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente servo-360.",
  "",
  "O servo de rotacao continua: o write() vira velocidade e sentido.",
  "",
  "Ligado numa ESP32 DevKit V1, com o que ele precisa para funcionar",
  "de verdade: o driver, o motor e a bateria de cada um.",
  "",
  "A placa esta no cabo USB (na barra dela: USB -> cabo ligado); a bateria e so do motor."
 ],
 "codigo": [
  "#include <ESP32Servo.h>",
  "",
  "// No servo 360 o write() e velocidade: 90 para, 0 e 180 sao o maximo",
  "// de cada lado, e o que fica no meio e mais devagar.",
  "Servo roda;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  roda.attach(13);",
  "  Serial.println(\"servo 360 pronto\");",
  "}",
  "",
  "void loop() {",
  "  Serial.println(\"rapido para um lado\");",
  "  roda.write(0);",
  "  delay(1500);",
  "  Serial.println(\"parado\");",
  "  roda.write(90);",
  "  delay(1000);",
  "  Serial.println(\"devagar para o outro\");",
  "  roda.write(135);",
  "  delay(1500);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 60,
    "Y": 60,
    "Usb": true
   },
   {
    "Id": "peca",
    "Tipo": "servo-360",
    "X": 300,
    "Y": 60
   },
   {
    "Id": "pilhas",
    "Tipo": "bateria",
    "X": 300,
    "Y": 300,
    "Volts": 6,
    "MiliAmperes": 2000,
    "MiliAmperesHora": 2500,
    "Nome": "4 pilhas AA (6 V)"
   }
  ],
  "Fios": [
   {
    "DePeca": "pilhas",
    "DePino": "+",
    "ParaPeca": "peca",
    "ParaPino": "V+",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "pilhas",
    "DePino": "-",
    "ParaPeca": "peca",
    "ParaPino": "GND",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "placa",
    "DePino": "GND.2",
    "ParaPeca": "peca",
    "ParaPino": "GND",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "placa",
    "DePino": "D13",
    "ParaPeca": "peca",
    "ParaPino": "PWM",
    "Cor": "#F07F1A"
   }
  ]
 }
}