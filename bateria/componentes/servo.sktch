{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente servo.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: PWM → D13, V+ → VIN, GND → GND.1"
 ],
 "codigo": [
  "#include <Servo.h>",
  "",
  "Servo meu;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  meu.attach(13);",
  "  Serial.println(\"servo pronto\");",
  "}",
  "",
  "void loop() {",
  "  meu.write(0);",
  "  delay(300);",
  "  meu.write(180);",
  "  delay(300);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "servo",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "PWM",
    "ParaPeca": "placa",
    "ParaPino": "D13",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "V+",
    "ParaPeca": "placa",
    "ParaPino": "VIN",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}