{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente micro-switch.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: COM → GND.1, NO → D15"
 ],
 "codigo": [
  "const int PINO = 15;",
  "const int LED = 2;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(PINO, INPUT_PULLUP);",
  "  pinMode(LED, OUTPUT);",
  "  Serial.println(\"entrada pronta\");",
  "}",
  "",
  "void loop() {",
  "  int estado = digitalRead(PINO);",
  "  digitalWrite(LED, estado == LOW ? HIGH : LOW);",
  "",
  "  Serial.print(\"botao: \");",
  "  Serial.println(estado);",
  "  delay(200);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "micro-switch",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "COM",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "NO",
    "ParaPeca": "placa",
    "ParaPino": "D15",
    "Cor": "#1A1A1A"
   }
  ]
 }
}