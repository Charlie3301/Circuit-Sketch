{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente max98357a.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: BCLK → D26, LRC → D25, DIN → D22, VIN → 3V3, GND → GND.1"
 ],
 "codigo": [
  "const int PINO = 2;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(PINO, OUTPUT);",
  "  Serial.println(\"saida pronta\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(PINO, HIGH);",
  "  delay(150);",
  "  digitalWrite(PINO, LOW);",
  "  delay(150);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "max98357a",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "BCLK",
    "ParaPeca": "placa",
    "ParaPino": "D26",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "LRC",
    "ParaPeca": "placa",
    "ParaPino": "D25",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "DIN",
    "ParaPeca": "placa",
    "ParaPino": "D22",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "VIN",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
