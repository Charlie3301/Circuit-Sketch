{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente ssd1306-i2c.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: VCC → 3V3, GND → GND.1, SDA → D21, SCL → D22"
 ],
 "codigo": [
  "#include <Adafruit_SSD1306.h>",
  "",
  "Adafruit_SSD1306 tela(128, 64);",
  "int voltas = 0;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  tela.begin(SSD1306_SWITCHCAPVCC, 0x3C);",
  "  Serial.println(\"oled pronto\");",
  "}",
  "",
  "void loop() {",
  "  tela.clearDisplay();",
  "  tela.setCursor(0, 0);",
  "  tela.print(\"voltas: \");",
  "  tela.print(voltas);",
  "  tela.display();",
  "",
  "  voltas++;",
  "  delay(400);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "ssd1306-i2c",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "SDA",
    "ParaPeca": "placa",
    "ParaPino": "D21",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "SCL",
    "ParaPeca": "placa",
    "ParaPino": "D22",
    "Cor": "#1A1A1A"
   }
  ]
 }
}