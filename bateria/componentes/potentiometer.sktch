{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente potentiometer.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: VCC → 3V3, SIG → D34, GND → GND.1"
 ],
 "codigo": [
  "const int PINO = 34;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  Serial.println(\"analogico pronto\");",
  "}",
  "",
  "void loop() {",
  "  int valor = analogRead(PINO);",
  "",
  "  Serial.print(\"leitura: \");",
  "  Serial.println(valor);",
  "  delay(200);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "potentiometer",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "SIG",
    "ParaPeca": "placa",
    "ParaPino": "D34",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}