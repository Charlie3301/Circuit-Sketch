{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente hc-sr04.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: VCC → 3V3, TRIG → D5, ECHO → D18, GND → GND.1"
 ],
 "codigo": [
  "const int TRIG = 5;",
  "const int ECHO = 18;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(TRIG, OUTPUT);",
  "  pinMode(ECHO, INPUT);",
  "  Serial.println(\"ultrassom pronto\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(TRIG, LOW);",
  "  delayMicroseconds(2);",
  "  digitalWrite(TRIG, HIGH);",
  "  delayMicroseconds(10);",
  "  digitalWrite(TRIG, LOW);",
  "",
  "  long tempo = pulseIn(ECHO, HIGH);",
  "  long cm = tempo / 58;",
  "",
  "  Serial.print(\"distancia: \");",
  "  Serial.println(cm);",
  "  delay(300);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "hc-sr04",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "TRIG",
    "ParaPeca": "placa",
    "ParaPino": "D5",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "ECHO",
    "ParaPeca": "placa",
    "ParaPino": "D18",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}