{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente dht11.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: VCC → 3V3, DATA → D4, GND → GND.1"
 ],
 "codigo": [
  "#include <DHT.h>",
  "",
  "DHT dht(4, DHT22);",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  dht.begin();",
  "  Serial.println(\"dht pronto\");",
  "}",
  "",
  "void loop() {",
  "  float t = dht.readTemperature();",
  "  float u = dht.readHumidity();",
  "",
  "  Serial.print(\"temperatura: \");",
  "  Serial.println(t);",
  "  Serial.print(\"umidade: \");",
  "  Serial.println(u);",
  "  delay(400);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "dht11",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "DATA",
    "ParaPeca": "placa",
    "ParaPino": "D4",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}