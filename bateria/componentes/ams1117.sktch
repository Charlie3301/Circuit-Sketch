{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente ams1117.",
  "",
  "O AMS1117 faz 3,3 V da LiPo 2S e liga a ESP32 direto pelo pino 3V3.",
  "",
  "Ligado numa ESP32 DevKit V1, com o que ele precisa para funcionar",
  "de verdade: o driver, o motor e a bateria de cada um."
 ],
 "codigo": [
  "const int PINO = 2;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(PINO, OUTPUT);",
  "  Serial.println(\"saida pronta\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(PINO, HIGH);",
  "  delay(150);",
  "  digitalWrite(PINO, LOW);",
  "  delay(150);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 40,
    "Y": 40
   },
   {
    "Id": "peca",
    "Tipo": "ams1117",
    "X": 300,
    "Y": 200
   },
   {
    "Id": "pilhas",
    "Tipo": "bateria",
    "X": 560,
    "Y": 200,
    "Volts": 7.4,
    "MiliAmperes": 20000,
    "MiliAmperesHora": 1000,
    "Nome": "LiPo 2S 1000 mAh (7,4 V)"
   }
  ],
  "Fios": [
   {
    "DePeca": "pilhas",
    "DePino": "+",
    "ParaPeca": "peca",
    "ParaPino": "VIN",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "pilhas",
    "DePino": "-",
    "ParaPeca": "peca",
    "ParaPino": "GND",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "VOUT",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}