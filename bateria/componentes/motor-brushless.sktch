{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente motor-brushless.",
  "",
  "O A2212 (sem escova) pelo ESC, numa LiPo 3S.",
  "",
  "Ligado numa ESP32 DevKit V1, com o que ele precisa para funcionar",
  "de verdade: o driver, o motor e a bateria de cada um.",
  "",
  "A placa esta no cabo USB (na barra dela: USB -> cabo ligado); a bateria e so do motor."
 ],
 "codigo": [
  "#include <ESP32Servo.h>",
  "",
  "// O ESC le um pulso de servo: 1000 us e o acelerador no minimo,",
  "// 2000 us e o maximo. Ele so arma (os bipes) com o minimo primeiro.",
  "Servo esc;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  esc.attach(13, 1000, 2000);",
  "  esc.writeMicroseconds(1000);",
  "  Serial.println(\"armando o ESC (acelerador no minimo)...\");",
  "  delay(3000);",
  "  Serial.println(\"armado\");",
  "}",
  "",
  "void loop() {",
  "  Serial.println(\"acelerador em 30%\");",
  "  esc.writeMicroseconds(1300);",
  "  delay(3000);",
  "  Serial.println(\"acelerador em 60%\");",
  "  esc.writeMicroseconds(1600);",
  "  delay(3000);",
  "  Serial.println(\"parado\");",
  "  esc.writeMicroseconds(1000);",
  "  delay(3000);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "peca",
    "Tipo": "motor-brushless",
    "X": 40,
    "Y": 40
   },
   {
    "Id": "esc",
    "Tipo": "esc",
    "X": 240,
    "Y": 120
   },
   {
    "Id": "pilhas",
    "Tipo": "bateria",
    "X": 560,
    "Y": 20,
    "Volts": 11.1,
    "MiliAmperes": 20000,
    "MiliAmperesHora": 2200,
    "Nome": "LiPo 3S 2200 mAh (11,1 V)"
   },
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 620,
    "Y": 150,
    "Usb": true
   }
  ],
  "Fios": [
   {
    "DePeca": "pilhas",
    "DePino": "+",
    "ParaPeca": "esc",
    "ParaPino": "BAT+",
    "Cor": "#D23B33"
   },
   {
    "DePeca": "pilhas",
    "DePino": "-",
    "ParaPeca": "esc",
    "ParaPino": "BAT-",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "placa",
    "DePino": "GND.2",
    "ParaPeca": "esc",
    "ParaPino": "GND",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "placa",
    "DePino": "D13",
    "ParaPeca": "esc",
    "ParaPino": "SINAL",
    "Cor": "#E8B400"
   },
   {
    "DePeca": "esc",
    "DePino": "A",
    "ParaPeca": "peca",
    "ParaPino": "A",
    "Cor": "#1F6FD1"
   },
   {
    "DePeca": "esc",
    "DePino": "B",
    "ParaPeca": "peca",
    "ParaPino": "B",
    "Cor": "#E8B400"
   },
   {
    "DePeca": "esc",
    "DePino": "C",
    "ParaPeca": "peca",
