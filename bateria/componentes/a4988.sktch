    "Cor": "#1F6FD1"
   },
   {
    "DePeca": "peca",
    "DePino": "2A",
    "ParaPeca": "motor",
    "ParaPino": "B+",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "2B",
