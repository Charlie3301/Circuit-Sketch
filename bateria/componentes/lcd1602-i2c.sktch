{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste do componente lcd1602-i2c.",
  "",
  "Ligado numa ESP32 DevKit V1, que tem pino para tudo — assim o",
  "que muda de um teste para o outro é só a peça.",
  "",
  "Pinos ligados: VCC → 3V3, GND → GND.1, SDA → D21, SCL → D22"
 ],
 "codigo": [
  "#include <LiquidCrystal_I2C.h>",
  "",
  "LiquidCrystal_I2C lcd(0x27, 16, 2);",
  "int voltas = 0;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  lcd.init();",
  "  lcd.backlight();",
  "  Serial.println(\"lcd pronto\");",
  "}",
  "",
  "void loop() {",
  "  lcd.setCursor(0, 0);",
  "  lcd.print(\"CircuitSketch\");",
  "  lcd.setCursor(0, 1);",
  "  lcd.print(voltas);",
  "",
  "  voltas++;",
  "  delay(400);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 100,
    "Y": 60
   },
   {
    "Id": "peca",
    "Tipo": "lcd1602-i2c",
    "X": 520,
    "Y": 160
   }
  ],
  "Fios": [
   {
    "DePeca": "peca",
    "DePino": "VCC",
    "ParaPeca": "placa",
    "ParaPino": "3V3",
    "Cor": "#00A651"
   },
   {
    "DePeca": "peca",
    "DePino": "GND",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "SDA",
    "ParaPeca": "placa",
    "ParaPino": "D21",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "peca",
    "DePino": "SCL",
    "ParaPeca": "placa",
    "ParaPino": "D22",
    "Cor": "#1A1A1A"
   }
  ]
 }
}