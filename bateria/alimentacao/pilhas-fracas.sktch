{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Duas pilhas AA (3 V) no VIN: nao bastam.",
  "",
  "O regulador do VIN precisa de ~4,3 V para dar 3,3 V: com 3 V a placa",
  "nao liga, e o aviso diz quanto falta. Mude para 4 pilhas (6 V) na",
  "barra da bateria e ela liga."
 ],
 "codigo": [
  "// Sem o cabo USB: esta placa so roda se a bateria a alimentar.",
  "const int LED = 2;",
  "",
  "void setup() {",
  "  Serial.begin(115200);",
  "  pinMode(LED, OUTPUT);",
  "  Serial.println(\"ligou pela bateria\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(LED, HIGH);",
  "  delay(300);",
  "  digitalWrite(LED, LOW);",
  "  delay(300);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "esp32-devkit-v1",
    "X": 60,
    "Y": 40
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 360,
    "Y": 60,
    "Cor": "verde"
   },
   {
    "Id": "r",
    "Tipo": "resistor",
    "X": 340,
    "Y": 180,
    "Ohms": 330
   },
   {
    "Id": "bateria",
    "Tipo": "bateria",
    "X": 380,
    "Y": 300,
    "Volts": 3,
    "MiliAmperes": 2000,
    "MiliAmperesHora": 2500,
    "Nome": "2 pilhas AA (3 V)"
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "D2",
    "ParaPeca": "r",
    "ParaPino": "1",
    "Cor": "#00A651"
   },
   {
    "DePeca": "r",
