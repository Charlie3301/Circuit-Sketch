{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste da linguagem arduino-cpp.",
  "",
  "Todas as dez fazem exatamente a mesma coisa — piscar um LED e",
  "contar — para que a comparação entre elas fique limpa."
 ],
 "codigo": [
  "// Bateria — Arduino (C++).",
  "",
  "const int LED = 13;",
  "",
  "void setup() {",
  "  Serial.begin(9600);",
  "  pinMode(LED, OUTPUT);",
  "  Serial.println(\"cpp acordou\");",
  "}",
  "",
  "void loop() {",
  "  digitalWrite(LED, HIGH);",
  "  delay(250);",
  "  digitalWrite(LED, LOW);",
  "  delay(250);",
  "}"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 120,
    "Y": 60
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 520,
    "Y": 120,
    "Cor": "vermelho"
   },
   {
    "Id": "r",
    "Tipo": "resistor",
    "X": 520,
    "Y": 280,
    "Ohms": 330
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "13",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "r",
    "ParaPino": "1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "r",
    "DePino": "2",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}