{
 "formato": "sktch",
 "versao": 1,
 "gerado": "bateria de testes (Alpha 18; pecas da Alpha 23; alimentacao da Alpha 24)",
 "descricao": [
  "Teste da linguagem cowgol.",
  "",
  "Todas as dez fazem exatamente a mesma coisa — piscar um LED e",
  "contar — para que a comparação entre elas fique limpa."
 ],
 "codigo": [
  "# Bateria — Cowgol.",
  "",
  "sub main() is",
  "    var led: uint8 := 13;",
  "",
  "    pin_mode(led, OUTPUT);",
  "",
  "    loop",
  "        digital_write(led, HIGH);",
  "        delay_ms(250);",
  "        digital_write(led, LOW);",
  "        delay_ms(250);",
  "    end loop;",
  "end sub;"
 ],
 "circuito": {
  "Pecas": [
   {
    "Id": "placa",
    "Tipo": "arduino-uno",
    "X": 120,
    "Y": 60
   },
   {
    "Id": "led",
    "Tipo": "led",
    "X": 520,
    "Y": 120,
    "Cor": "vermelho"
   },
   {
    "Id": "r",
    "Tipo": "resistor",
    "X": 520,
    "Y": 280,
    "Ohms": 330
   }
  ],
  "Fios": [
   {
    "DePeca": "placa",
    "DePino": "13",
    "ParaPeca": "led",
    "ParaPino": "A",
    "Cor": "#00A651"
   },
   {
    "DePeca": "led",
    "DePino": "C",
    "ParaPeca": "r",
    "ParaPino": "1",
    "Cor": "#1A1A1A"
   },
   {
    "DePeca": "r",
    "DePino": "2",
    "ParaPeca": "placa",
    "ParaPino": "GND.1",
    "Cor": "#1A1A1A"
   }
  ]
 }
}